@model RPImobiliaria.Models.CertificadoEnergetico

@{
    ViewData["Title"] = "Detalhes do Certificado";
}

<div class="container mt-4 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="mb-4 text-center">
            <h2 class="fw-bold mb-1"><i class="bi bi-info-circle-fill text-primary me-2"></i> @ViewData["Title"]</h2>
            <p class="text-body-secondary mb-0">Informações registadas no sistema.</p>
        </div>

        <div class="card shadow-sm border-0 border-top border-5 border-primary">
            <div class="card-body p-4 p-md-5">

                <div class="mb-4 border-bottom pb-3">
                    <h6 class="text-muted fw-bold text-uppercase small mb-1">Identificador (ID)</h6>
                    <p class="fs-5 fw-mono text-primary mb-0">#@Model?.Id</p>
                </div>

                <div class="mb-4 pb-3">
                    <h6 class="text-muted fw-bold text-uppercase small mb-1">Classe Energética</h6>
                    <p class="fs-4 fw-bold mb-0">@Model?.Nome</p>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4 shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary fw-bold px-4 shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Editar Dados
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>