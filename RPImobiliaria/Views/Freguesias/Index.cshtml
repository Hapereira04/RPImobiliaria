@model IEnumerable<RPImobiliaria.Models.Freguesia>
@{ ViewData["Title"] = "Freguesias"; }
<div class="container py-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h3 fw-bold mb-1">Freguesias</h1><p class="text-body-secondary mb-0">Último nível da localização apresentada nos imóveis.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nova freguesia</a></div><div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Freguesia</th><th>Concelho</th><th>Distrito</th><th class="text-end">Ações</th></tr></thead><tbody>@foreach (var freguesia in Model) { <tr><td class="fw-semibold">@freguesia.Nome</td><td>@freguesia.Concelho.Nome</td><td>@freguesia.Concelho.Distrito.Nome</td><td class="text-end"><a asp-action="Details" asp-route-id="@freguesia.Id" class="btn btn-sm btn-light border">Ver</a><a asp-action="Edit" asp-route-id="@freguesia.Id" class="btn btn-sm btn-outline-primary">Editar</a><a asp-action="Delete" asp-route-id="@freguesia.Id" class="btn btn-sm btn-outline-danger">Apagar</a></td></tr> }</tbody></table></div></div></div>
