@model RPImobiliaria.Models.Freguesia

@{
    ViewData["Title"] = "Editar Freguesia";
}

<div class="container mt-4 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="mb-4 text-center">
            <h2 class="fw-bold mb-1 text-body-emphasis">
                <i class="bi bi-pencil-square text-primary me-2"></i> @ViewData["Title"]
            </h2>
            <p class="text-body-secondary mb-0">Atualize os dados desta freguesia.</p>
        </div>

        <div class="card shadow-sm border-0 border-top border-5 border-primary">
            <div class="card-body p-4 p-md-5">

                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="form-floating mb-4">
                        <select asp-for="ConcelhoId" class="form-select form-control-lg border-primary shadow-sm bg-white text-dark" asp-items="ViewBag.ConcelhoId">
                            <option value="">-- Selecione o Concelho --</option>
                        </select>
                        <label asp-for="ConcelhoId" class="text-dark fw-bold">Concelho <span class="text-danger">*</span></label>
                        <span asp-validation-for="ConcelhoId" class="text-danger small fw-bold"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Nome" class="form-control form-control-lg border-primary shadow-sm bg-white text-dark" placeholder="Nome da Freguesia" autofocus />
                        <label asp-for="Nome" class="text-dark fw-bold">Nome da Freguesia <span class="text-danger">*</span></label>
                        <span asp-validation-for="Nome" class="text-danger small fw-bold"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4 shadow-sm">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Guardar Alterações
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}