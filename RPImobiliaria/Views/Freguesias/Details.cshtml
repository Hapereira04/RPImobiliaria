@model RPImobiliaria.Models.Freguesia

@{
    ViewData["Title"] = "Detalhes da Freguesia";
}

<div class="container mt-4 mb-5 d-flex justify-content-center">
    <div class="col-md-9 col-lg-8">

        <div class="mb-4 text-center">
            <h2 class="fw-bold mb-1 text-body-emphasis">
                <i class="bi bi-info-circle-fill text-primary me-2"></i> @ViewData["Title"]
            </h2>
            <p class="text-body-secondary mb-0">Informações detalhadas sobre esta freguesia e a sua localização administrativa.</p>
        </div>

        <div class="card shadow-sm border-0 border-top border-5 border-primary mb-4">
            <div class="card-body p-4 p-md-5">

                <div class="bg-white p-4 rounded border border-secondary-subtle mb-4">
                    <div class="row g-3 border-bottom border-secondary-subtle pb-3 mb-3">
                        <div class="col-sm-6 border-bottom border-sm-0 border-end-sm border-secondary-subtle pb-3 pb-sm-0">
                            <h6 class="text-dark fw-bold text-uppercase small mb-1">Identificador (ID)</h6>
                            <p class="fs-5 fw-mono text-primary mb-0">#@Model?.Id</p>
                        </div>

                        <div class="col-sm-6">
                            <h6 class="text-dark fw-bold text-uppercase small mb-1">Distrito</h6>
                            <p class="fs-5 fw-bold text-dark mb-0">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i> @(Model?.Concelho?.Distrito?.Nome ?? "N/D")
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6 border-bottom border-sm-0 border-end-sm border-secondary-subtle pb-3 pb-sm-0">
                            <h6 class="text-dark fw-bold text-uppercase small mb-1">Concelho</h6>
                            <p class="fs-5 fw-bold text-dark mb-0">
                                <i class="bi bi-building text-secondary me-1"></i> @(Model?.Concelho?.Nome ?? "N/D")
                            </p>
                        </div>

                        <div class="col-sm-6">
                            <h6 class="text-dark fw-bold text-uppercase small mb-1">Nome da Freguesia</h6>
                            <p class="fs-4 fw-bold text-dark mb-0">@Model?.Nome</p>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4 shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary fw-bold px-4 shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Editar Freguesia
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>