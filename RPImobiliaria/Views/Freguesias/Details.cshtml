@model RPImobiliaria.Models.Freguesia
@{ ViewData["Title"] = Model.Nome; }
<div class="container py-4"><a asp-action="Index" class="btn btn-link px-0 mb-3"><i class="bi bi-arrow-left"></i> Freguesias</a><div class="card border-0 shadow-sm"><div class="card-body p-4"><div class="d-flex justify-content-between gap-3"><div><p class="text-uppercase text-body-secondary small fw-bold mb-1">@Model.Concelho.Distrito.Nome · @Model.Concelho.Nome</p><h1 class="h3 fw-bold">@Model.Nome</h1></div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary align-self-start">Editar</a></div><hr /><p class="text-body-secondary mb-0">Esta freguesia pode ser selecionada como localização pública de um imóvel.</p></div></div></div>
