@model RPImobiliaria.Models.Caracteristica

@{
    ViewData["Title"] = "Adicionar Característica";
}

<div class="container mt-4 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="mb-4 text-center">
            <h2 class="fw-bold mb-1 text-body-emphasis">
                <i class="bi bi-plus-circle-fill text-primary me-2"></i> @ViewData["Title"]
            </h2>
            <p class="text-body-secondary mb-0">Preencha os dados abaixo para criar um novo registo.</p>
        </div>

        <div class="card shadow-sm border-0 border-top border-5 border-primary">
            <div class="card-body p-4 p-md-5">

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Nome" class="form-control form-control-lg border-primary shadow-sm bg-white text-dark" placeholder="Nome da característica" autofocus />
                        <label asp-for="Nome" class="text-dark fw-bold">Nome da Característica <span class="text-danger">*</span></label>
                        <span asp-validation-for="Nome" class="text-danger small fw-bold"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <select asp-for="GrupoCaracteristicaId" class="form-select form-control-lg border-primary shadow-sm bg-white text-dark" asp-items="ViewBag.GrupoCaracteristicaId">
                            <option value="">-- Selecione o Grupo --</option>
                        </select>
                        <label asp-for="GrupoCaracteristicaId" class="text-dark fw-bold">Grupo de Característica <span class="text-danger">*</span></label>
                        <span asp-validation-for="GrupoCaracteristicaId" class="text-danger small fw-bold"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4 shadow-sm">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Guardar Registo
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}