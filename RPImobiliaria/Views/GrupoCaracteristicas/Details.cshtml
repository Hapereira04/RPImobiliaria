@model RPImobiliaria.Models.GrupoCaracteristica

@{
    ViewData["Title"] = "Detalhes do Grupo de Características";
    var caracteristicas = Model?.Caracteristicas ?? new List<RPImobiliaria.Models.Caracteristica>();
}

<div class="container mt-4 mb-5 d-flex justify-content-center">
    <div class="col-md-9 col-lg-8">

        <div class="mb-4 text-center">
            <h2 class="fw-bold mb-1 text-body-emphasis">
                <i class="bi bi-info-circle-fill text-primary me-2"></i> @ViewData["Title"]
            </h2>
            <p class="text-body-secondary mb-0">Informações e características associadas a este grupo.</p>
        </div>

        <div class="card shadow-sm border-0 border-top border-5 border-primary mb-4">
            <div class="card-body p-4 p-md-5">

                <div class="bg-white p-4 rounded border border-secondary-subtle mb-4">
                    <div class="mb-3 border-bottom border-secondary-subtle pb-3">
                        <h6 class="text-dark fw-bold text-uppercase small mb-1">Identificador (ID)</h6>
                        <p class="fs-5 fw-mono text-primary mb-0">#@Model?.Id</p>
                    </div>

                    <div>
                        <h6 class="text-dark fw-bold text-uppercase small mb-1">Nome do Grupo</h6>
                        <p class="fs-4 fw-bold text-dark mb-0">@Model?.Nome</p>
                    </div>
                </div>

                <div class="bg-white p-4 rounded border border-secondary-subtle">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary-subtle">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-tags-fill text-primary me-2"></i> Características Associadas
                        </h5>
                        <span class="badge bg-primary rounded-pill px-3 py-2">
                            @caracteristicas.Count @(caracteristicas.Count == 1 ? "Característica" : "Características")
                        </span>
                    </div>

                    @if (!caracteristicas.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 mb-2 d-block opacity-50 text-dark"></i>
                            <span class="text-dark fw-medium d-block">Nenhuma característica associada a este grupo até ao momento.</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var carac in caracteristicas)
                            {
                                <div class="bg-light text-dark fw-bold px-3 py-2 rounded border border-secondary-subtle d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <span>@carac.Nome</span>
                                    <span class="badge bg-secondary text-white small">#@carac.Id</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4 shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary fw-bold px-4 shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Editar Grupo
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>