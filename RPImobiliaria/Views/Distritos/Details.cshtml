@model RPImobiliaria.Models.Distrito
@{ ViewData["Title"] = Model.Nome; }
<div class="container py-4"><a asp-action="Index" class="btn btn-link px-0 mb-3"><i class="bi bi-arrow-left"></i> Distritos</a><div class="card border-0 shadow-sm"><div class="card-body p-4"><div class="d-flex justify-content-between gap-3"><div><p class="text-uppercase text-body-secondary small fw-bold">Distrito</p><h1 class="h3 fw-bold">@Model.Nome</h1></div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary align-self-start">Editar</a></div><hr /><h2 class="h5 fw-bold">Concelhos (@Model.Concelhos.Count)</h2>@if (Model.Concelhos.Any()) { <ul class="list-group list-group-flush">@foreach (var concelho in Model.Concelhos.OrderBy(c => c.Nome)) { <li class="list-group-item d-flex justify-content-between px-0"><span>@concelho.Nome</span><span class="text-body-secondary small">@concelho.Freguesias.Count freguesia@(concelho.Freguesias.Count == 1 ? "" : "s")</span></li> }</ul> } else { <p class="text-body-secondary mb-0">Ainda não existem concelhos associados.</p> }</div></div></div>
