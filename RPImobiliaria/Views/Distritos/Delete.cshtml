@model RPImobiliaria.Models.Distrito
@{ ViewData["Title"] = "Apagar distrito"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-6"><div class="card border-danger shadow-sm"><div class="card-body p-4"><i class="bi bi-exclamation-triangle text-danger fs-2"></i><h1 class="h4 fw-bold mt-2">Apagar “@Model.Nome”?</h1><p class="text-body-secondary">Esta ação só é possível se o distrito não tiver concelhos associados. Atualmente tem <strong>@Model.Concelhos.Count</strong>.</p><form asp-action="Delete"><input asp-for="Id" type="hidden" /><a asp-action="Index" class="btn btn-light border">Cancelar</a><button type="submit" class="btn btn-danger">Apagar distrito</button></form></div></div></div></div></div>
