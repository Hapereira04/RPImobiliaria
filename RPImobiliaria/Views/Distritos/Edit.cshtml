@model RPImobiliaria.Models.Distrito
@{ ViewData["Title"] = "Editar distrito"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-6"><a asp-action="Index" class="btn btn-link px-0 mb-3"><i class="bi bi-arrow-left"></i> Voltar</a><div class="card border-0 shadow-sm"><div class="card-body p-4"><h1 class="h3 fw-bold">Editar distrito</h1><form asp-action="Edit"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-floating mb-4"><input asp-for="Nome" class="form-control" placeholder="Nome" /><label asp-for="Nome">Nome do distrito</label><span asp-validation-for="Nome" class="text-danger small"></span></div><button class="btn btn-primary" type="submit">Guardar alterações</button></form></div></div></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
