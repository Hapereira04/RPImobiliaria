@model RPImobiliaria.Models.Imovel
@{
    ViewData["Title"] = Model.Titulo;
    var fotos = Model.Fotos.OrderBy(f => f.Ordem).ToList();
    var referencia = Model.Referencia ?? Model.Id.ToString();
    var precoM2 = Model.AreaUtil > 0 ? Model.Preco / (decimal)Model.AreaUtil : 0;
    var localizacao = string.Join(", ", new[] { Model.Freguesia?.Nome, Model.Freguesia?.Concelho?.Nome, Model.Freguesia?.Concelho?.Distrito?.Nome }.Where(x => !string.IsNullOrWhiteSpace(x)));
    var caracteristicas = Model.Caracteristicas.Where(c => c.Caracteristica?.GrupoCaracteristica is not null).GroupBy(c => c.Caracteristica!.GrupoCaracteristica!.Nome).OrderBy(g => g.Key);
    var equipa = User.IsInRole("Admin") || User.IsInRole("Consultor");
}

<style>
    .imovel-gallery { background: #0f172a; min-height: 420px; }
    .imovel-gallery img { height: min(64vh, 650px); width: 100%; object-fit: cover; }
    .gallery-thumb { width: 72px; height: 54px; border: 2px solid transparent; object-fit: cover; opacity: .7; cursor: pointer; }
    .gallery-thumb.active, .gallery-thumb:hover { border-color: #fff; opacity: 1; }
    .detail-stat { border-radius: 1rem; background: var(--bs-tertiary-bg); height: 100%; }
    .detail-stat i { color: var(--bs-primary); font-size: 1.3rem; }
    .contact-card { top: 1.25rem; border-radius: 1rem; overflow: hidden; }
    .spec-row:last-child { border-bottom: 0 !important; }
</style>

<section class="bg-body-tertiary border-bottom">
    <div class="container py-3 d-flex flex-wrap justify-content-between gap-2 align-items-center">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Início</a></li><li class="breadcrumb-item"><a asp-action="Index">Imóveis</a></li><li class="breadcrumb-item active text-truncate" aria-current="page">@Model.Titulo</li></ol></nav>
        @if (equipa) { <div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square me-1"></i>Editar</a><a asp-action="Gestao" class="btn btn-sm btn-outline-secondary">Gestão</a></div> }
    </div>
</section>

<section class="imovel-gallery position-relative">
    @if (fotos.Any())
    {
        <div id="imovelCarousel" class="carousel slide" data-bs-ride="false">
            <div class="carousel-inner">
                @for (var indice = 0; indice < fotos.Count; indice++)
                {
                    <div class="carousel-item @(indice == 0 ? "active" : "")"><img src="@fotos[indice].CaminhoImagem" alt="@Model.Titulo - fotografia @(indice + 1)" /></div>
                }
            </div>
            @if (fotos.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#imovelCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span><span class="visually-hidden">Anterior</span></button>
                <button class="carousel-control-next" type="button" data-bs-target="#imovelCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span><span class="visually-hidden">Seguinte</span></button>
            }
        </div>
        @if (fotos.Count > 1)
        {
            <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 d-flex gap-2 overflow-auto mw-100 px-3">@for (var indice = 0; indice < fotos.Count; indice++) { <button type="button" class="p-0 bg-transparent border-0" data-bs-target="#imovelCarousel" data-bs-slide-to="@indice" aria-label="Ver fotografia @(indice + 1)"><img class="gallery-thumb rounded @(indice == 0 ? "active" : "")" src="@fotos[indice].CaminhoImagem" alt="" /></button> }</div>
        }
    }
    else
    {
        <div class="d-flex flex-column gap-2 align-items-center justify-content-center text-white" style="min-height: 420px;"><i class="bi bi-house display-3 opacity-50"></i><span>Fotografias disponíveis brevemente</span></div>
    }
</section>

<main class="container py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
                <div>
                    <div class="d-flex gap-2 flex-wrap mb-3"><span class="badge text-bg-primary px-3 py-2">@(Model.TipoNegocio?.Nome ?? "Imóvel")</span>@if (!string.IsNullOrWhiteSpace(Model.StatusImovel?.Nome)) { <span class="badge text-bg-light border px-3 py-2">@Model.StatusImovel.Nome</span> }</div>
                    <h1 class="display-6 fw-bold mb-2">@Model.Titulo</h1>
                    <p class="text-body-secondary mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@(string.IsNullOrWhiteSpace(localizacao) ? "Localização por indicar" : localizacao)</p>
                </div>
                <div class="text-lg-end"><div class="display-6 fw-bold text-primary">@Model.Preco.ToString("N0") €</div><span class="text-body-secondary small">Ref. @referencia</span></div>
            </div>

            <div class="row row-cols-2 row-cols-md-4 g-3 mb-5">
                <div class="col"><div class="detail-stat p-3"><i class="bi bi-door-open d-block mb-2"></i><span class="small text-body-secondary d-block">Quartos</span><strong>T@(Model.Quartos)</strong></div></div>
                <div class="col"><div class="detail-stat p-3"><i class="bi bi-droplet d-block mb-2"></i><span class="small text-body-secondary d-block">Casas de banho</span><strong>@Model.CasasBanho WC</strong></div></div>
                <div class="col"><div class="detail-stat p-3"><i class="bi bi-aspect-ratio d-block mb-2"></i><span class="small text-body-secondary d-block">Área útil</span><strong>@Model.AreaUtil.ToString("N0") m²</strong></div></div>
                <div class="col"><div class="detail-stat p-3"><i class="bi bi-cash-coin d-block mb-2"></i><span class="small text-body-secondary d-block">Preço / m²</span><strong>@(precoM2 > 0 ? precoM2.ToString("N0") + " €" : "—")</strong></div></div>
            </div>

            <section class="mb-5"><h2 class="h4 fw-bold border-bottom pb-3 mb-3">Sobre este imóvel</h2><p class="lh-lg text-body-emphasis mb-0" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.Descricao) ? "Contacte-nos para conhecer todos os detalhes deste imóvel." : Model.Descricao)</p></section>

            <section class="mb-5"><h2 class="h4 fw-bold border-bottom pb-3 mb-3">Detalhes</h2><div class="row g-0 border rounded overflow-hidden"><div class="col-md-6 p-3 border-bottom spec-row"><span class="text-body-secondary small d-block">Tipo de imóvel</span><strong>@(Model.CategoriaImovel?.Nome ?? "—")</strong></div><div class="col-md-6 p-3 border-bottom spec-row"><span class="text-body-secondary small d-block">Estado</span><strong>@(Model.EstadoImovel?.Nome ?? "—")</strong></div><div class="col-md-6 p-3 border-bottom spec-row"><span class="text-body-secondary small d-block">Área bruta</span><strong>@(Model.AreaBruta > 0 ? Model.AreaBruta.ToString("N0") + " m²" : "—")</strong></div><div class="col-md-6 p-3 border-bottom spec-row"><span class="text-body-secondary small d-block">Estacionamento</span><strong>@(Model.Estacionamento > 0 ? Model.Estacionamento + " lugar(es)" : "—")</strong></div><div class="col-md-6 p-3 border-bottom spec-row"><span class="text-body-secondary small d-block">Ano de construção</span><strong>@(Model.AnoConstrucao > 0 ? Model.AnoConstrucao.ToString() : "—")</strong></div><div class="col-md-6 p-3 border-bottom spec-row"><span class="text-body-secondary small d-block">Certificado energético</span><strong>@(Model.CertificadoEnergetico?.Nome ?? "—")</strong></div></div></section>

            @if (caracteristicas.Any())
            {
                <section class="mb-5"><h2 class="h4 fw-bold border-bottom pb-3 mb-3">Características</h2><div class="row g-3">@foreach (var grupo in caracteristicas) { <div class="col-md-6"><div class="border rounded-4 h-100 p-3"><h3 class="h6 fw-bold mb-3">@grupo.Key</h3><div class="d-flex flex-wrap gap-2">@foreach (var item in grupo) { <span class="badge text-bg-light border fw-normal"> <i class="bi bi-check2 text-success me-1"></i>@item.Caracteristica!.Nome</span> }</div></div></div> }</div></section>
            }

            @if (equipa)
            {
                <section class="card border-warning-subtle bg-warning bg-opacity-10 mb-4"><div class="card-header bg-transparent border-warning-subtle fw-bold"><i class="bi bi-shield-lock me-2"></i>Informação interna</div><div class="card-body"><div class="row g-3"><div class="col-md-6"><span class="text-body-secondary small d-block">Morada exata</span><strong>@(Model.MoradaExata ?? "—")</strong></div><div class="col-md-6"><span class="text-body-secondary small d-block">Contrato</span><strong>@(Model.NumeroContrato ?? "—")</strong></div><div class="col-md-6"><span class="text-body-secondary small d-block">Comissão prevista</span><strong>@(Model.ValorComissao?.ToString("C0") ?? "—")</strong></div><div class="col-md-6"><span class="text-body-secondary small d-block">Notas</span><strong>@(Model.ObservacoesInternas ?? "—")</strong></div></div>@if (Model.Documentos.Any()) { <hr /><div class="d-flex flex-wrap gap-2">@foreach (var documento in Model.Documentos) { <a href="@documento.CaminhoFicheiro" target="_blank" class="btn btn-sm btn-outline-dark"><i class="bi bi-file-earmark-arrow-down me-1"></i>@documento.NomeFicheiro</a> }</div> }</div></section>
            }
        </div>

        <aside class="col-lg-4"><div class="card contact-card border-0 shadow-sm position-sticky"><div class="card-body p-4"><p class="text-uppercase text-primary fw-bold small mb-2">Tem interesse?</p><h2 class="h4 fw-bold mb-3">Fale connosco sobre este imóvel.</h2>@if (Model.Consultor is not null) { <div class="d-flex align-items-center gap-3 border-top border-bottom py-3 mb-4"><div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 48px;height:48px;">@Model.Consultor.Nome[..1].ToUpper()</div><div><strong class="d-block">@Model.Consultor.Nome</strong><a href="tel:@Model.Consultor.Telemovel" class="small text-decoration-none">@Model.Consultor.Telemovel</a></div></div> }<form asp-controller="Home" asp-action="EnviarContacto" method="post"><input type="hidden" name="Assunto" value="Pedido de informação — Ref. @referencia" /><div class="form-floating mb-2"><input name="Nome" class="form-control" placeholder="Nome" required /><label>O seu nome</label></div><div class="form-floating mb-2"><input name="Contacto" class="form-control" placeholder="Telefone ou e-mail" required /><label>Telefone ou e-mail</label></div><div class="form-floating mb-3"><textarea name="Mensagem" class="form-control" placeholder="Mensagem" style="height: 110px" required>Gostaria de receber mais informações sobre o imóvel Ref. @referencia.</textarea><label>Mensagem</label></div><button class="btn btn-primary w-100 fw-bold" type="submit">Pedir contacto <i class="bi bi-send ms-1"></i></button></form></div></div></aside>
    </div>
</main>
