@model RPImobiliaria.Models.Imovel
@{
    ViewData["Title"] = Model.Titulo;
    var fotos = Model.Fotos?.OrderBy(f => f.Ordem).ToList() ?? new List<RPImobiliaria.Models.FotoImovel>();
    var referencia = Model.Referencia ?? Model.Id.ToString();

    // Cálculo seguro de Preço/m²
    double areaReferencia = (Model.AreaUtil.HasValue && Model.AreaUtil.Value > 0)
        ? Model.AreaUtil.Value
        : Model.AreaBruta;
    var precoM2 = areaReferencia > 0 ? Model.Preco / (decimal)areaReferencia : 0;

    var nomeFreguesia = Model.Freguesia?.Nome;
    var nomeConcelho = Model.Concelho?.Nome ?? Model.Freguesia?.Concelho?.Nome;
    var nomeDistrito = Model.Distrito?.Nome ?? Model.Freguesia?.Concelho?.Distrito?.Nome;

    var locParts = new List<string>();
    if (!string.IsNullOrWhiteSpace(nomeFreguesia)) locParts.Add(nomeFreguesia);
    if (!string.IsNullOrWhiteSpace(nomeConcelho)) locParts.Add(nomeConcelho);
    if (!string.IsNullOrWhiteSpace(nomeDistrito)) locParts.Add(nomeDistrito);

    var localizacao = locParts.Any() ? string.Join(", ", locParts.Distinct()) : "Localização por indicar";
    var caracteristicas = Model.Caracteristicas?
            .Where(c => c.Caracteristica?.GrupoCaracteristica is not null)
            .GroupBy(c => c.Caracteristica!.GrupoCaracteristica!.Nome)
            .OrderBy(g => g.Key) ?? Enumerable.Empty<IGrouping<string, RPImobiliaria.Models.ImovelCaracteristica>>();

    var equipa = User.IsInRole("Admin") || User.IsInRole("Consultor");
}

<style>
    /* CAIXA DO CARROSSEL FIXA */
    .imovel-carousel-wrapper {
        height: 70vh;
        min-height: 500px;
        max-height: 750px;
        width: 100%;
        background-color: var(--bs-body-bg);
        touch-action: pan-y pinch-zoom;
    }

    .imovel-carousel-wrapper .carousel-inner,
    .imovel-carousel-wrapper .carousel-item {
        height: 100%;
        width: 100%;
    }

    /* IMAGEM CENTRADA E COM PROPORÇÃO MANTIDA */
    .imovel-carousel-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        cursor: zoom-in;
    }

    /* Miniaturas na base */
    .gallery-thumb {
        width: 80px;
        height: 60px;
        border: 2px solid transparent;
        object-fit: cover;
        opacity: 0.6;
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

    .gallery-thumb.active, .gallery-thumb:hover {
        border-color: var(--bs-primary);
        opacity: 1;
    }

    /* Cartões de estatísticas forçados a Branco/Preto */
    .detail-stat {
        border-radius: 1rem;
        background: #ffffff;
        border: 1px solid #dee2e6;
        height: 100%;
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
    }

    .detail-stat i {
        color: var(--bs-primary);
        font-size: 1.3rem;
    }

    .contact-card {
        top: 1.25rem;
        border-radius: 1rem;
        overflow: hidden;
    }

    .spec-row:last-child {
        border-bottom: 0 !important;
    }
</style>

<!-- BREADCRUMB -->
<section class="bg-body-tertiary border-bottom">
    <div class="container py-3 d-flex flex-wrap justify-content-between gap-2 align-items-center">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none fw-bold">Início</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none fw-bold">Imóveis</a></li>
                <li class="breadcrumb-item active text-body-emphasis text-truncate fw-medium" aria-current="page">@Model.Titulo</li>
            </ol>
        </nav>
        @if (equipa)
        {
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary fw-bold shadow-sm"><i class="bi bi-pencil-square me-1"></i>Editar</a>
                <a asp-action="Gestao" class="btn btn-sm btn-outline-secondary fw-bold shadow-sm">Gestão</a>
            </div>
        }
    </div>
</section>

<!-- GALERIA DE FOTOS COM SUPORTE A SWIPE -->
<section class="bg-body-tertiary pb-4">
    <div class="container-xl pt-4">
        @if (fotos.Any())
        {
            <div id="imovelCarousel" class="carousel slide bg-body rounded-4 shadow-sm overflow-hidden imovel-carousel-wrapper" data-bs-ride="false" data-bs-touch="true">
                <div class="carousel-inner">
                    @for (var indice = 0; indice < fotos.Count; indice++)
                    {
                        <div class="carousel-item @(indice == 0 ? "active" : "")" onclick="abrirFullscreen(@indice)">
                            <img src="@fotos[indice].CaminhoImagem" alt="@Model.Titulo - fotografia @(indice + 1)" title="Clique para expandir" />
                        </div>
                    }
                </div>
                @if (fotos.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#imovelCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true" style="opacity: 0.5;"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#imovelCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true" style="opacity: 0.5;"></span>
                        <span class="visually-hidden">Seguinte</span>
                    </button>
                }
            </div>

            @if (fotos.Count > 1)
            {
                <div class="d-flex justify-content-center gap-2 mt-3 overflow-auto pb-2 px-1">
                    @for (var indice = 0; indice < fotos.Count; indice++)
                    {
                        <button type="button" class="p-0 bg-transparent border-0 flex-shrink-0" data-bs-target="#imovelCarousel" data-bs-slide-to="@indice" aria-label="Ver fotografia @(indice + 1)">
                            <img class="gallery-thumb @(indice == 0 ? "active" : "")" src="@fotos[indice].CaminhoImagem" alt="" />
                        </button>
                    }
                </div>
            }
        }
        else
        {
            <div class="d-flex flex-column gap-2 align-items-center justify-content-center bg-body rounded-4 shadow-sm text-muted imovel-carousel-wrapper">
                <i class="bi bi-house display-3 opacity-50"></i>
                <span class="fw-bold">Fotografias disponíveis brevemente</span>
            </div>
        }
    </div>
</section>

<main class="container py-5">
    <div class="row g-5">

        <!-- CONTEÚDO PRINCIPAL -->
        <div class="col-lg-8">

            <!-- AVISO DE IMÓVEL OCULTO DO CATÁLOGO (Apenas Equipa vê) -->
            @if (Model.OcultoDoCatalogo && equipa)
            {
                <div class="alert alert-warning border-warning d-flex align-items-center mb-4 py-2 px-3 fw-bold small rounded-3 shadow-sm">
                    <i class="bi bi-eye-slash-fill fs-5 me-2"></i>
                    Este imóvel está oculto do catálogo público. Apenas quem tem a ligação direta consegue aceder.
                </div>
            }

            <!-- CABEÇALHO DO IMÓVEL -->
            <div class="bg-white p-4 rounded-4 shadow-sm border border-secondary-subtle mb-4">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                    <div>
                        <div class="d-flex gap-2 flex-wrap mb-3">
                            <span class="badge bg-white text-dark border border-secondary-subtle px-3 py-2 shadow-sm fw-bold">@(Model.TipoNegocio?.Nome ?? "Imóvel")</span>

                            @if (!string.IsNullOrWhiteSpace(Model.StatusImovel?.Nome))
                            {
                                <span class="badge bg-white text-dark border border-secondary-subtle shadow-sm px-3 py-2 fw-bold">@Model.StatusImovel.Nome</span>
                            }
                        </div>
                        <h1 class="display-6 fw-bold mb-2 text-dark">@Model.Titulo</h1>
                        <p class="mb-0 fw-bold text-secondary">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(string.IsNullOrWhiteSpace(localizacao) ? "Localização por indicar" : localizacao)
                        </p>
                    </div>
                    <div class="text-lg-end">
                        <div class="display-6 fw-bold" style="color: #198754 !important;">@Model.Preco.ToString("N0") €</div>
                        <span class="small fw-bold text-secondary">Ref. @referencia</span>
                    </div>
                </div>
            </div>

            <!-- QUADRADOS DE DESTAQUE DINÂMICOS -->
            <div class="row row-cols-2 row-cols-md-4 g-3 mb-5">

                @* 1. Quartos (só exibe se > 0) *@
                @if (Model.Quartos.HasValue && Model.Quartos.Value > 0)
                {
                    <div class="col">
                        <div class="detail-stat p-3 text-center">
                            <i class="bi bi-door-open d-block mb-2"></i>
                            <span class="small d-block fw-bold text-secondary">Tipologia</span>
                            <strong class="text-dark fs-5">T@(Model.Quartos)</strong>
                        </div>
                    </div>
                }

                @* 2. Casas de Banho (só exibe se > 0) *@
                @if (Model.CasasBanho.HasValue && Model.CasasBanho.Value > 0)
                {
                    <div class="col">
                        <div class="detail-stat p-3 text-center">
                            <i class="bi bi-droplet d-block mb-2"></i>
                            <span class="small d-block fw-bold text-secondary">Casas de banho</span>
                            <strong class="text-dark fs-5">@Model.CasasBanho WC</strong>
                        </div>
                    </div>
                }

                @* 3. Área Total / Útil com detalhe para terreno misto *@
                <div class="col">
                    <div class="detail-stat p-3 text-center">
                        <i class="bi bi-aspect-ratio d-block mb-2"></i>
                        <span class="small d-block fw-bold text-secondary">
                            @(Model.AreaUtil.HasValue && Model.AreaUtil.Value > 0 ? "Área útil" : "Área total")
                        </span>
                        <strong class="text-dark fs-5">
                            @(Model.AreaUtil.HasValue && Model.AreaUtil.Value > 0
                                ? Model.AreaUtil.Value.ToString("N0")
                                : Model.AreaBruta.ToString("N0")) m²
                        </strong>
                        @if (Model.TipoTerreno == "Misto" && Model.AreaUrbana > 0 && Model.AreaRustica > 0)
                        {
                            <span class="d-block text-secondary small fw-bold mt-1" style="font-size: 0.72rem;">
                                (@Model.AreaUrbana?.ToString("N0")m² urb. / @Model.AreaRustica?.ToString("N0")m² rús.)
                            </span>
                        }
                    </div>
                </div>

                @* 4. Preço por m² *@
                <div class="col">
                    <div class="detail-stat p-3 text-center">
                        <i class="bi bi-cash-coin d-block mb-2"></i>
                        <span class="small d-block fw-bold text-secondary">Preço / m²</span>
                        <strong class="text-dark fs-5">@(precoM2 > 0 ? precoM2.ToString("N0") + " €" : "—")</strong>
                    </div>
                </div>
            </div>

            <!-- DESCRIÇÃO -->
            <section class="mb-5 bg-white p-4 rounded-4 border border-secondary-subtle shadow-sm">
                <h2 class="h4 fw-bold border-bottom border-secondary-subtle pb-3 mb-3 text-dark">Sobre este imóvel</h2>
                <p class="lh-lg text-dark mb-0 fw-medium" style="white-space: pre-line;">
                    @(string.IsNullOrWhiteSpace(Model.Descricao) ? "Contacte-nos para conhecer todos os detalhes deste imóvel." : Model.Descricao)
                </p>
            </section>

            <!-- DETALHES TÉCNICOS -->
            <section class="mb-5 bg-white p-4 rounded-4 border border-secondary-subtle shadow-sm">
                <h2 class="h4 fw-bold border-bottom border-secondary-subtle pb-3 mb-3 text-dark">Detalhes</h2>
                <div class="row g-0 border border-secondary-subtle rounded overflow-hidden">
                    <div class="col-md-6 p-3 border-bottom border-secondary-subtle spec-row">
                        <span class="small d-block fw-bold text-secondary">Tipo de imóvel</span>
                        <strong class="text-dark">@(Model.CategoriaImovel?.Nome ?? "—")</strong>
                    </div>

                    @* Classificação do Terreno (se for terreno) *@
                    @if (!string.IsNullOrWhiteSpace(Model.TipoTerreno))
                    {
                        <div class="col-md-6 p-3 border-bottom border-secondary-subtle spec-row">
                            <span class="small d-block fw-bold text-secondary">Classificação do Terreno</span>
                            <strong class="text-dark">Terreno @Model.TipoTerreno</strong>
                        </div>
                    }

                    <div class="col-md-6 p-3 border-bottom border-secondary-subtle spec-row">
                        <span class="small d-block fw-bold text-secondary">Área total</span>
                        <strong class="text-dark">@(Model.AreaBruta > 0 ? Model.AreaBruta.ToString("N0") + " m²" : "—")</strong>
                    </div>

                    @* Detalhe de parcelas se for Misto *@
                    @if (Model.TipoTerreno == "Misto")
                    {
                        @if (Model.AreaUrbana.HasValue && Model.AreaUrbana.Value > 0)
                        {
                            <div class="col-md-6 p-3 border-bottom border-secondary-subtle spec-row">
                                <span class="small d-block fw-bold text-secondary">Parcela Urbana</span>
                                <strong class="text-primary">@Model.AreaUrbana.Value.ToString("N0") m²</strong>
                            </div>
                        }
                        @if (Model.AreaRustica.HasValue && Model.AreaRustica.Value > 0)
                        {
                            <div class="col-md-6 p-3 border-bottom border-secondary-subtle spec-row">
                                <span class="small d-block fw-bold text-secondary">Parcela Rústica</span>
                                <strong class="text-success">@Model.AreaRustica.Value.ToString("N0") m²</strong>
                            </div>
                        }
                    }

                    @if (Model.AreaUtil.HasValue && Model.AreaUtil.Value > 0)
                    {
                        <div class="col-md-6 p-3 border-bottom border-secondary-subtle spec-row">
                            <span class="small d-block fw-bold text-secondary">Área útil</span>
                            <strong class="text-dark">@Model.AreaUtil.Value.ToString("N0") m²</strong>
                        </div>
                    }

                    @if (Model.EstadoImovel != null && !string.IsNullOrWhiteSpace(Model.EstadoImovel.Nome))
                    {
                        <div class="col-md-6 p-3 border-bottom border-secondary-subtle spec-row">
                            <span class="small d-block fw-bold text-secondary">Estado</span>
                            <strong class="text-dark">@Model.EstadoImovel.Nome</strong>
                        </div>
                    }

                    @if (Model.Estacionamento.HasValue && Model.Estacionamento.Value > 0)
                    {
                        <div class="col-md-6 p-3 border-bottom border-secondary-subtle spec-row">
                            <span class="small d-block fw-bold text-secondary">Estacionamento</span>
                            <strong class="text-dark">@Model.Estacionamento.Value lugar(es)</strong>
                        </div>
                    }

                    @if (Model.AnoConstrucao.HasValue && Model.AnoConstrucao.Value > 0)
                    {
                        <div class="col-md-6 p-3 border-bottom border-secondary-subtle spec-row">
                            <span class="small d-block fw-bold text-secondary">Ano de construção</span>
                            <strong class="text-dark">@Model.AnoConstrucao.Value</strong>
                        </div>
                    }

                    @* SÓ MOSTRA SE TIVER PREENCHIDO (Se for "Isento", mostra "Isento"; se não preencher, oculta) *@
                    @if (Model.CertificadoEnergetico != null && !string.IsNullOrWhiteSpace(Model.CertificadoEnergetico.Nome))
                    {
                        <div class="col-md-6 p-3 border-bottom border-secondary-subtle spec-row">
                            <span class="small d-block fw-bold text-secondary">Certificado energético</span>
                            <strong class="text-dark">@Model.CertificadoEnergetico.Nome</strong>
                        </div>
                    }
                </div>
            </section>

            <!-- CARACTERÍSTICAS -->
            @if (caracteristicas.Any())
            {
                <section class="mb-5 bg-white p-4 rounded-4 border border-secondary-subtle shadow-sm">
                    <h2 class="h4 fw-bold border-bottom border-secondary-subtle pb-3 mb-3 text-dark">Características</h2>
                    <div class="row g-3">
                        @foreach (var grupo in caracteristicas)
                        {
                            <div class="col-md-6">
                                <div class="border border-secondary-subtle rounded-4 h-100 p-3 bg-white">
                                    <h3 class="h6 fw-bold mb-3 text-dark">@grupo.Key</h3>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var item in grupo)
                                        {
                                            <span class="badge bg-white text-dark border border-secondary-subtle fw-bold shadow-sm">
                                                <i class="bi bi-check-circle-fill text-success me-1"></i>@item.Caracteristica!.Nome
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- INFORMAÇÃO INTERNA (Visível apenas para a Equipa) -->
            @if (equipa)
            {
                <section class="card border-warning-subtle bg-white mb-4 shadow-sm border-start border-5 border-warning">
                    <div class="card-header bg-white border-bottom border-secondary-subtle fw-bold text-dark py-3 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-shield-lock-fill text-warning me-2"></i>Informação Interna (Privada)</span>
                        <span class="badge bg-warning text-dark">Acesso Restrito</span>
                    </div>
                    <div class="card-body bg-white p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <span class="small d-block fw-bold text-secondary">Morada exata</span>
                                <strong class="text-dark">@(string.IsNullOrWhiteSpace(Model.MoradaExata) ? "—" : Model.MoradaExata)</strong>
                            </div>
                            <div class="col-md-6">
                                <span class="small d-block fw-bold text-secondary">Contrato</span>
                                <strong class="text-dark">@(string.IsNullOrWhiteSpace(Model.NumeroContrato) ? "—" : Model.NumeroContrato)</strong>
                            </div>

                            <!-- COMISSÃO PREVISTA (% E € COM INDICAÇÃO DE IVA) -->
                            <div class="col-md-6">
                                <span class="small d-block fw-bold text-secondary">Comissão prevista</span>
                                <strong class="text-success fs-5">
                                    @{
                                        decimal? perc = Model.PercentagemComissao;
                                        if ((!perc.HasValue || perc.Value <= 0) && Model.ValorComissao.HasValue && Model.Preco > 0)
                                        {
                                            perc = (Model.ValorComissao.Value / Model.Preco) * 100m;
                                        }
                                    }

                                    @if (Model.ValorComissao.HasValue && Model.ValorComissao.Value > 0)
                                    {
                                        @Model.ValorComissao.Value.ToString("N2") <text>€</text>
                                        @if (perc.HasValue && perc.Value > 0)
                                        {
                                            <span class="fs-6 text-muted">(@perc.Value.ToString("0.##")%)</span>
                                        }
                                        <span class="badge @(Model.ComissaoComIva ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") border ms-1 fs-6">
                                            @(Model.ComissaoComIva ? "IVA Incluído" : "+ IVA")
                                        </span>
                                    }
                                    else if (perc.HasValue && perc.Value > 0)
                                    {
                                        <span>@perc.Value.ToString("0.##")%</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </strong>
                            </div>

                            <div class="col-md-6">
                                <span class="small d-block fw-bold text-secondary">Data de Registo</span>
                                <strong class="text-dark">@Model.DataRegisto.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>

                            <div class="col-md-6">
                                <span class="small d-block fw-bold text-secondary">Proprietário(s)</span>
                                @if (Model.Proprietarios != null && Model.Proprietarios.Any())
                                {
                                    @foreach (var p in Model.Proprietarios)
                                    {
                                        <span class="badge bg-light text-dark border me-1">
                                            <i class="bi bi-person-fill text-primary me-1"></i>@(p.Cliente?.Nome ?? "Cliente #" + p.ClienteId)
                                        </span>
                                    }
                                }
                                else
                                {
                                    <strong class="text-dark">—</strong>
                                }
                            </div>

                            <div class="col-12">
                                <span class="small d-block fw-bold text-secondary">Notas / Observações Internas</span>
                                <p class="text-dark mb-0 fw-medium bg-light p-3 rounded border" style="white-space: pre-line;">
                                    @(string.IsNullOrWhiteSpace(Model.ObservacoesInternas) ? "Sem observações internas registadas." : Model.ObservacoesInternas)
                                </p>
                            </div>
                        </div>

                        <!-- Documentos Privados -->
                        @if (Model.Documentos != null && Model.Documentos.Any())
                        {
                            <hr class="border-secondary-subtle my-3" />
                            <div>
                                <span class="small d-block fw-bold text-secondary mb-2"><i class="bi bi-file-earmark-pdf text-danger me-1"></i>Documentos Anexados (@Model.Documentos.Count)</span>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var documento in Model.Documentos)
                                    {
                                        <a href="@documento.CaminhoFicheiro" target="_blank" class="btn btn-sm btn-outline-dark fw-bold shadow-sm">
                                            <i class="bi bi-file-earmark-arrow-down-fill text-danger me-1"></i>@documento.NomeFicheiro
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <!-- CONTACTO LATERAL -->
        <aside class="col-lg-4">
            <div class="card contact-card border border-primary-subtle shadow-lg position-sticky bg-white" style="top: 2rem;">
                <div class="card-body p-4 bg-white">
                    <p class="text-uppercase text-primary fw-bold small mb-2"><i class="bi bi-chat-dots-fill me-1"></i> Tem interesse?</p>
                    <h2 class="h4 fw-bold mb-3 text-dark">Fale connosco sobre este imóvel.</h2>

                    @if (Model.Consultor is not null)
                    {
                        <div class="d-flex align-items-center gap-3 border-top border-bottom border-secondary-subtle py-3 mb-4">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm border border-primary-subtle" style="width: 48px;height:48px; font-size: 1.2rem;">
                                @Model.Consultor.Nome[..1].ToUpper()
                            </div>
                            <div>
                                <strong class="d-block text-dark">@Model.Consultor.Nome</strong>
                                <a href="tel:@Model.Consultor.Telemovel" class="small text-decoration-none fw-bold text-secondary">
                                    <i class="bi bi-telephone-fill text-success me-1"></i> @Model.Consultor.Telemovel
                                </a>
                            </div>
                        </div>
                    }

                    <form asp-controller="Home" asp-action="EnviarContacto" method="post">
                        <input type="hidden" name="Assunto" value="Pedido de informação — Ref. @referencia" />

                        <div class="form-floating mb-2">
                            <input name="Nome" class="form-control bg-white text-dark border-secondary-subtle fw-medium" placeholder="Nome" required />
                            <label class="text-dark fw-bold">O seu nome</label>
                        </div>
                        <div class="form-floating mb-2">
                            <input name="Contacto" class="form-control bg-white text-dark border-secondary-subtle fw-medium" placeholder="Telefone ou e-mail" required />
                            <label class="text-dark fw-bold">Telefone ou e-mail</label>
                        </div>
                        <div class="form-floating mb-3">
                            <textarea name="Mensagem" class="form-control bg-white text-dark border-secondary-subtle fw-medium" placeholder="Mensagem" style="height: 110px" required>Gostaria de receber mais informações sobre o imóvel Ref. @referencia.</textarea>
                            <label class="text-dark fw-bold">Mensagem</label>
                        </div>
                        <button class="btn btn-primary w-100 fw-bold shadow-sm p-3" type="submit">
                            Pedir contacto <i class="bi bi-send-fill ms-1"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>
    </div>
</main>

<!-- MODAL FULLSCREEN -->
<div class="modal fade" id="fotoFullscreenModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark">
            <div class="position-absolute top-0 end-0 p-4" style="z-index: 9999;">
                <button type="button" class="btn-close btn-close-white shadow-lg" data-bs-dismiss="modal" aria-label="Fechar" style="background-color: rgba(0,0,0,0.6); padding: 15px; border-radius: 50%; opacity: 1;"></button>
            </div>

            <div class="modal-body d-flex align-items-center justify-content-center p-0">
                <div id="carouselFullscreen" class="carousel slide w-100 h-100" data-bs-ride="false" data-bs-touch="true">
                    <div class="carousel-inner w-100 h-100 d-flex align-items-center">
                        @for (var i = 0; i < fotos.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "") w-100 h-100">
                                <img src="@fotos[i].CaminhoImagem" class="d-block w-100 h-100" style="object-fit: contain;" alt="Foto @(i + 1)">
                            </div>
                        }
                    </div>
                    @if (fotos.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselFullscreen" data-bs-slide="prev" style="z-index: 1050;">
                            <span class="carousel-control-prev-icon" aria-hidden="true" style="width: 3rem; height: 3rem;"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselFullscreen" data-bs-slide="next" style="z-index: 1050;">
                            <span class="carousel-control-next-icon" aria-hidden="true" style="width: 3rem; height: 3rem;"></span>
                            <span class="visually-hidden">Seguinte</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirFullscreen(index) {
            const modal = new bootstrap.Modal(document.getElementById('fotoFullscreenModal'));
            const carouselFullscreen = document.getElementById('carouselFullscreen');
            const bsCarousel = bootstrap.Carousel.getOrCreateInstance(carouselFullscreen);
            bsCarousel.to(index);
            modal.show();
        }

        // SUPORTE AO GESTO DE TOQUE (SWIPE) PARA TELEMÓVEIS E TABLETS
        function ativarSwipeTouch(idElemento) {
            const el = document.getElementById(idElemento);
            if (!el) return;
            let startX = 0;
            let endX = 0;
            el.addEventListener('touchstart', e => {
                startX = e.changedTouches[0].screenX;
            }, { passive: true });
            el.addEventListener('touchend', e => {
                endX = e.changedTouches[0].screenX;
                const bsCarousel = bootstrap.Carousel.getOrCreateInstance(el);
                if (startX - endX > 45) bsCarousel.next();
                if (endX - startX > 45) bsCarousel.prev();
            }, { passive: true });
        }

        document.addEventListener("DOMContentLoaded", function () {
            ativarSwipeTouch('imovelCarousel');
            ativarSwipeTouch('carouselFullscreen');
        });
    </script>
}