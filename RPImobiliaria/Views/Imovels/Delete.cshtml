@model RPImobiliaria.Models.Imovel
@{
    ViewData["Title"] = "Apagar Imóvel";
}

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger shadow-lg bg-white">

            <div class="card-header bg-danger text-white p-4 text-center border-0">
                <i class="bi bi-exclamation-triangle-fill display-1 mb-3"></i>
                <h2 class="fw-bold mb-0">Zona de Perigo</h2>
            </div>

            <div class="card-body p-5 text-center bg-white">
                <h4 class="fw-bold mb-3 text-dark">Tem a certeza absoluta que deseja apagar este imóvel?</h4>
                <p class="mb-4 fw-medium" style="color: #6c757d;">
                    Esta ação é <strong class="text-danger">irreversível</strong>. Todas as fotografias, documentos e notas associadas serão eliminados permanentemente.
                </p>

                <!-- CAIXA DE RESUMO DO IMÓVEL A BRANCO E PRETO -->
                <div class="card border border-secondary-subtle bg-white text-start mb-4 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary fs-6 shadow-sm">Ref: @(Model.Referencia ?? Model.Id.ToString())</span>
                            <span class="badge bg-success fs-6 shadow-sm">@Model.Preco.ToString("C0")</span>
                        </div>

                        <h5 class="fw-bold mt-3 text-dark">@Model.Titulo</h5>

                        <p class="small mb-2 fw-bold" style="color: #6c757d;">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                            @(Model.Freguesia != null ? Model.Freguesia.Nome : "Freguesia não definida"),
                            @(Model.Freguesia?.Concelho != null ? Model.Freguesia.Concelho.Nome : "Concelho não definido")
                        </p>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-bold px-4 shadow-sm">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger btn-lg fw-bold px-4 shadow">
                            <i class="bi bi-trash3-fill me-2"></i> Apagar Imóvel
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>