@model IEnumerable<RPImobiliaria.Models.Imovel>

@{
    ViewData["Title"] = "Gestão de Imóveis";
}

<div class="container mt-4 mb-5">

    <!-- CABEÇALHO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-body-emphasis">
                <i class="bi bi-building-gear text-primary me-2"></i> @ViewData["Title"]
            </h2>
            <p class="text-body-secondary mb-0">Crie, edite e acompanhe os imóveis da sua carteira de angariações.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary fw-bold shadow-sm">
                <i class="bi bi-journal-album me-1"></i> Ver Catálogo
            </a>
            <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Novo Imóvel
            </a>
        </div>
    </div>

    <!-- MENSAGENS DE ALERTA -->
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-success-subtle mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-danger-subtle mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- TABELA FIXADA EM FUNDO BRANCO E TEXTO PRETO -->
    <div class="card shadow-sm border-0 border-secondary-subtle overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 bg-white text-dark">
                <thead class="bg-light border-bottom border-secondary-subtle">
                    <tr>
                        <th class="py-3 ps-4 text-dark text-uppercase small fw-bold">Referência</th>
                        <th class="py-3 text-dark text-uppercase small fw-bold">Imóvel</th>
                        <th class="py-3 text-dark text-uppercase small fw-bold">Localização</th>
                        <th class="py-3 text-dark text-uppercase small fw-bold">Preço</th>
                        <th class="py-3 text-dark text-uppercase small fw-bold">Estado</th>
                        <th class="py-3 pe-4 text-dark text-uppercase small fw-bold text-end">Ações</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted bg-white">
                                <i class="bi bi-building-dash fs-2 d-block mb-2 opacity-50"></i> Ainda não existem imóveis para gerir na carteira.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var imovel in Model)
                        {
                            <tr class="border-bottom border-secondary-subtle bg-white">
                                <td class="ps-4 fw-bold text-dark bg-white">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        @(imovel.Referencia ?? $"REF-{imovel.Id}")
                                    </span>
                                </td>
                                <td class="bg-white">
                                    <a asp-action="Details" asp-route-id="@imovel.Id" class="text-decoration-none fw-bold text-primary">@imovel.Titulo</a>
                                    <small class="d-block fw-bold" style="color: #6c757d;">@(imovel.TipoNegocio?.Nome ?? "—")</small>
                                </td>
                                @{
                                    var nomeFreguesia = imovel.Freguesia?.Nome;
                                    var nomeConcelho = imovel.Concelho?.Nome ?? imovel.Freguesia?.Concelho?.Nome;
                                    var nomeDistrito = imovel.Distrito?.Nome ?? imovel.Freguesia?.Concelho?.Distrito?.Nome;

                                    var locParts = new List<string>();
                                    if (!string.IsNullOrWhiteSpace(nomeFreguesia)) locParts.Add(nomeFreguesia);
                                    if (!string.IsNullOrWhiteSpace(nomeConcelho)) locParts.Add(nomeConcelho);
                                    if (!string.IsNullOrWhiteSpace(nomeDistrito)) locParts.Add(nomeDistrito);

                                    var txtLocalizacao = locParts.Any() ? string.Join(", ", locParts.Distinct()) : "—";
                                }
                                <td class="bg-white text-dark fw-medium">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@txtLocalizacao
                                </td>
                                <td class="fw-bold bg-white" style="color: #198754 !important;">
                                    @imovel.Preco.ToString("N0") €
                                </td>
                                <td class="bg-white">
                                    <span class="badge bg-light text-dark border border-secondary-subtle px-2 py-1 shadow-sm">
                                        @(imovel.StatusImovel?.Nome ?? "—")
                                    </span>
                                </td>
                                <td class="pe-4 text-end bg-white">
                                    <div class="d-flex justify-content-end gap-1 shadow-sm">

                                        <!-- BOTÃO DE DESTAQUE (Estrela Amarela ou Cinzenta) -->
                                        <form asp-action="AlternarDestaque" asp-route-id="@imovel.Id" method="post" class="m-0">
                                            <button type="submit" class="btn btn-sm @(imovel.EmDestaque ? "btn-warning text-dark" : "btn-outline-secondary")" title="@(imovel.EmDestaque ? "Remover Destaque" : "Destacar Imóvel (Máx 3)")">
                                                <i class="bi @(imovel.EmDestaque ? "bi-star-fill" : "bi-star")"></i>
                                            </button>
                                        </form>

                                        <!-- BOTÕES NORMAIS -->
                                        <a asp-action="Details" asp-route-id="@imovel.Id" class="btn btn-outline-secondary btn-sm" title="Ver Detalhes"><i class="bi bi-eye-fill"></i></a>
                                        <a asp-action="Edit" asp-route-id="@imovel.Id" class="btn btn-outline-secondary btn-sm" title="Editar"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Delete" asp-route-id="@imovel.Id" class="btn btn-outline-danger btn-sm" title="Apagar"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>