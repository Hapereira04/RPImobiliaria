@model IEnumerable<RPImobiliaria.Models.Imovel>
@{ ViewData["Title"] = "Gerir imóveis"; }
<div class="container py-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h3 fw-bold mb-1">Gerir imóveis</h1><p class="text-body-secondary mb-0">Crie, edite e acompanhe os imóveis da carteira.</p></div><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-light border">Ver catálogo</a><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Novo imóvel</a></div></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Referência</th><th>Imóvel</th><th>Localização</th><th>Preço</th><th>Estado</th><th class="text-end">Ações</th></tr></thead><tbody>@if (!Model.Any()) { <tr><td colspan="6" class="text-center py-5 text-body-secondary">Ainda não existem imóveis para gerir.</td></tr> } @foreach (var imovel in Model) { <tr><td class="fw-semibold">@(imovel.Referencia ?? imovel.Id.ToString())</td><td><a asp-action="Details" asp-route-id="@imovel.Id" class="text-decoration-none fw-semibold">@imovel.Titulo</a><small class="d-block text-body-secondary">@(imovel.TipoNegocio?.Nome ?? "—")</small></td><td>@(imovel.Freguesia?.Concelho?.Nome ?? "—")</td><td class="fw-semibold">@imovel.Preco.ToString("N0") €</td><td><span class="badge text-bg-light border">@(imovel.StatusImovel?.Nome ?? "—")</span></td><td class="text-end"><a asp-action="Edit" asp-route-id="@imovel.Id" class="btn btn-sm btn-outline-primary">Editar</a><a asp-action="Delete" asp-route-id="@imovel.Id" class="btn btn-sm btn-outline-danger">Apagar</a></td></tr> }</tbody></table></div></div></div>
