@model IEnumerable<RPImobiliaria.Models.Consultor>

@{
    ViewData["Title"] = "Equipa de Consultores";
}

<div class="container mt-4 mb-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i> @ViewData["Title"]</h2>
            <p class="text-body-secondary mb-0">Gestão dos membros da equipa e acessos ao sistema</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Adicionar Consultor
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-secondary-subtle text-center p-5">
            <div class="card-body">
                <i class="bi bi-person-x text-body-tertiary" style="font-size: 4rem;"></i>
                <h4 class="mt-3 fw-bold">Nenhum consultor encontrado</h4>
                <p class="text-body-secondary">Ainda não existem membros da equipa registados no sistema.</p>
                <a asp-action="Create" class="btn btn-outline-primary mt-2 fw-bold">Adicionar o Primeiro Consultor</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-secondary-subtle hover-shadow transition-all">
                        <div class="card-body text-center p-4">

                            <div class="mb-3 mx-auto position-relative" style="width: 100px; height: 100px;">
                                <!-- NOVA LÓGICA DE IMAGEM DA LISTA DE CONSULTORES -->
                                @if (!string.IsNullOrEmpty(item.CaminhoFotoPerfil))
                                {
                                    <img src="@item.CaminhoFotoPerfil" class="rounded-circle object-fit-cover shadow-sm border border-3 border-secondary-subtle" style="width: 100%; height: 100%;" alt="Foto de @item.Nome">
                                }
                                else
                                {
                                    <div class="rounded-circle bg-body-tertiary d-flex align-items-center justify-content-center border border-3 border-secondary-subtle shadow-sm" style="width: 100%; height: 100%;">
                                        <i class="bi bi-person-fill text-body-secondary fs-1"></i>
                                    </div>
                                }
                            </div>

                            <h5 class="fw-bold text-body-emphasis mb-1">@item.Nome</h5>
                            <p class="small text-body-secondary mb-3">
                                @if (!string.IsNullOrEmpty(item.LicencaAMI))
                                {
                                    <span class="badge bg-secondary text-white">AMI-@item.LicencaAMI</span>
                                }
                                else
                                {
                                    <span class="badge border border-secondary text-body-secondary">Sem AMI Própria</span>
                                }
                            </p>

                            <div class="d-flex flex-column gap-2 text-start bg-body-tertiary p-3 rounded border border-secondary-subtle">
                                <div class="small d-flex align-items-center text-truncate" title="@item.Email">
                                    <i class="bi bi-envelope-at text-primary me-2"></i>
                                    <span class="text-truncate">@item.Email</span>
                                </div>
                                <div class="small d-flex align-items-center">
                                    <i class="bi bi-telephone text-success me-2"></i>
                                    <span>@(string.IsNullOrEmpty(item.Telemovel) ? "Sem número" : item.Telemovel)</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-top border-secondary-subtle p-3">
                            <div class="btn-group w-100 shadow-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm fw-bold" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm fw-bold" title="Ver Perfil">
                                    <i class="bi bi-person-vcard"></i> Detalhes
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm fw-bold" title="Apagar">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* Efeito suave ao passar o rato por cima do cartão */
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }

    .transition-all {
        transition: all 0.3s ease-in-out;
    }
</style>