@model RPImobiliaria.Models.Consultor

@{
    ViewData["Title"] = "Editar Consultor";
}

<div class="container mt-4 mb-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-primary me-2"></i> @ViewData["Title"]</h2>
            <p class="text-muted mb-0">Atualizar dados da ficha de @Model?.Nome</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary fw-bold shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
            <button type="submit" form="formEdit" class="btn btn-primary fw-bold shadow-sm">
                <i class="bi bi-save me-1"></i> Guardar
            </button>
        </div>
    </div>

    <form asp-action="Edit" id="formEdit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IdentityUserId" />

        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header py-3 fw-bold text-primary border-bottom">
                        <i class="bi bi-info-circle me-1"></i> Informação Pessoal e Profissional
                    </div>
                    <div class="card-body p-4">

                        <div class="form-floating mb-4">
                            <input asp-for="Nome" class="form-control form-control-lg border-primary" placeholder="Nome" />
                            <label asp-for="Nome">Nome Completo <span class="text-danger">*</span></label>
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6 form-floating">
                                <input asp-for="Email" class="form-control text-muted" style="background-color: var(--bs-secondary-bg);" placeholder="Email" readonly title="O email de login não pode ser alterado por aqui." />
                                <label asp-for="Email">Email (Login do Sistema) <i class="bi bi-lock-fill ms-1"></i></label>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 form-floating">
                                <input asp-for="Telemovel" class="form-control" placeholder="Telemóvel" />
                                <label asp-for="Telemovel">Telemóvel Profissional</label>
                                <span asp-validation-for="Telemovel" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-floating mb-2">
                            <input asp-for="LicencaAMI" class="form-control" placeholder="Licença AMI" />
                            <label asp-for="LicencaAMI">Licença AMI (Opcional)</label>
                            <span asp-validation-for="LicencaAMI" class="text-danger small"></span>
                        </div>
                        <div class="form-text text-muted small ms-1 mb-3">
                            Deixe em branco se a licença for a geral da agência.
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-lg border-primary mb-4 position-sticky" style="top: 1rem;">
                    <div class="card-header bg-primary text-white py-3 text-center border-0">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-camera me-2"></i> Foto de Perfil</h5>
                    </div>
                    <div class="card-body p-4 text-center">

                        <div class="mb-4 d-flex justify-content-center">
                            <div class="position-relative" style="width: 160px; height: 160px;">

                                <!-- NOVA LÓGICA DE PRÉ-VISUALIZAÇÃO DA IMAGEM -->
                                @if (!string.IsNullOrEmpty(Model?.CaminhoFotoPerfil))
                                {
                                    <img id="previewFoto" src="@Model.CaminhoFotoPerfil" class="rounded-circle object-fit-cover shadow-sm border border-3 border-primary" style="width: 100%; height: 100%;" alt="Foto de Perfil">
                                }
                                else
                                {
                                    <div id="previewPlaceholder" class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center border border-3 border-secondary shadow-sm" style="width: 100%; height: 100%;">
                                        <i class="bi bi-person-fill text-secondary" style="font-size: 5rem;"></i>
                                    </div>
                                    <!-- Imagem oculta que será usada pelo JavaScript quando for feito o upload -->
                                    <img id="previewFoto" src="" class="rounded-circle object-fit-cover shadow-sm border border-3 border-primary d-none" style="width: 100%; height: 100%;" alt="Foto de Perfil">
                                }
                            </div>
                        </div>

                        <div class="mb-4 text-start p-3 rounded border border-secondary" style="background-color: var(--bs-secondary-bg);">
                            <label for="fotoUpload" class="form-label small fw-bold text-uppercase mb-2">
                                <i class="bi bi-upload me-1"></i> Carregar Nova Foto
                            </label>
                            <input class="form-control form-control-sm border-primary" type="file" id="fotoUpload" name="fotoUpload" accept="image/*">
                            <div class="form-text small mt-2">
                                Formatos aceites: JPG, PNG.
                            </div>
                        </div>

                        <button type="submit" form="formEdit" class="btn btn-warning btn-lg w-100 fw-bold shadow text-dark mt-2">
                            <i class="bi bi-save-fill me-2"></i> Guardar
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('fotoUpload').addEventListener('change', function(event) {
            const file = event.target.files[0];
            const previewFoto = document.getElementById('previewFoto');
            const placeholder = document.getElementById('previewPlaceholder');

            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewFoto.src = e.target.result;
                    previewFoto.classList.remove('d-none');
                    if (placeholder) {
                        placeholder.classList.add('d-none');
                    }
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}