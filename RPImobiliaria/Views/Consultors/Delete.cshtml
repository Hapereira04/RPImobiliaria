@model RPImobiliaria.Models.Consultor

@{
    ViewData["Title"] = "Apagar Consultor";
}

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card border-danger shadow-lg">
            <div class="card-header bg-danger text-white p-4 text-center">
                <i class="bi bi-person-x-fill display-1 mb-3"></i>
                <h2 class="fw-bold mb-0">Apagar Consultor</h2>
            </div>

            <div class="card-body p-5 text-center">
                <h4 class="mb-3">Tem a certeza absoluta?</h4>
                <p class="text-muted mb-4">Esta ação é <strong>irreversível</strong>. A ficha de contacto do consultor será eliminada permanentemente. Os imóveis que ele angariou ficarão sem consultor atribuído.</p>

                <div class="card text-start mb-4 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-4">

                        <!-- NOVA LÓGICA DE IMAGEM: Apenas verifica se o caminho existe -->
                        @if (!string.IsNullOrEmpty(Model?.CaminhoFotoPerfil))
                        {
                            <img src="@Model.CaminhoFotoPerfil" alt="Foto de Perfil" class="rounded-circle object-fit-cover shadow-sm" style="width: 80px; height: 80px; border: 3px solid var(--bs-danger);" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center border border-secondary shadow-sm" style="width: 80px; height: 80px;">
                                <i class="bi bi-person-fill fs-1 text-secondary"></i>
                            </div>
                        }

                        <div>
                            <span class="badge bg-dark mb-2">ID: #@Model?.Id</span>
                            <h5 class="fw-bold mb-1">@Model?.Nome</h5>
                            <p class="small mb-1 text-muted"><i class="bi bi-envelope-fill me-1"></i> @Model?.Email</p>
                            <p class="small mb-0 text-muted"><i class="bi bi-telephone-fill me-1"></i> @(string.IsNullOrEmpty(Model?.Telemovel) ? "Sem contacto" : Model.Telemovel)</p>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-bold px-4">
                            <i class="bi bi-arrow-left me-2"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger btn-lg fw-bold px-4 shadow">
                            <i class="bi bi-trash3-fill me-2"></i> Sim, Apagar
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>