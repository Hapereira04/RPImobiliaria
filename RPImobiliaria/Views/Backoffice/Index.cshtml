@{
    ViewData["Title"] = "Configuração";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Configuração do sistema</h1>
        <p class="text-body-secondary mb-0">Gerir os catálogos que alimentam a criação e pesquisa dos imóveis.</p>
    </div>

    <h2 class="h6 text-uppercase text-body-secondary fw-bold mb-3">Localização</h2>
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <a asp-controller="Distritos" asp-action="Index" class="text-decoration-none text-reset">
                <div class="config-card card h-100">
                    <div class="card-body d-flex gap-3 align-items-center">
                        <div class="config-icon rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center">
                            <i class="bi bi-map fs-4"></i>
                        </div>
                        <div>
                            <h3 class="h6 fw-bold mb-1">Distritos</h3>
                            <p class="small text-body-secondary mb-0">Primeiro nível</p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Concelhos" asp-action="Index" class="text-decoration-none text-reset">
                <div class="config-card card h-100">
                    <div class="card-body d-flex gap-3 align-items-center">
                        <div class="config-icon rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center">
                            <i class="bi bi-pin-map fs-4"></i>
                        </div>
                        <div>
                            <h3 class="h6 fw-bold mb-1">Concelhos</h3>
                            <p class="small text-body-secondary mb-0">Cidades e concelhos</p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Freguesias" asp-action="Index" class="text-decoration-none text-reset">
                <div class="config-card card h-100">
                    <div class="card-body d-flex gap-3 align-items-center">
                        <div class="config-icon rounded-3 bg-warning-subtle text-warning-emphasis d-flex align-items-center justify-content-center">
                            <i class="bi bi-geo-alt fs-4"></i>
                        </div>
                        <div>
                            <h3 class="h6 fw-bold mb-1">Freguesias</h3>
                            <p class="small text-body-secondary mb-0">Localização do imóvel</p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <h2 class="h6 text-uppercase text-body-secondary fw-bold mb-3">Catálogos de imóveis</h2>
    <div class="row g-3">
        <div class="col-md-4 col-lg-3">
            <a asp-controller="TipoNegocios" asp-action="Index" class="btn btn-config-catalog w-100 text-start">Tipo de negócio</a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="CategoriaImovels" asp-action="Index" class="btn btn-config-catalog w-100 text-start">Categorias</a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="EstadoImovels" asp-action="Index" class="btn btn-config-catalog w-100 text-start">Estados</a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="StatusImovels" asp-action="Index" class="btn btn-config-catalog w-100 text-start">Disponibilidade</a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="CertificadoEnergeticoes" asp-action="Index" class="btn btn-config-catalog w-100 text-start">Certificados energéticos</a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="GrupoCaracteristicas" asp-action="Index" class="btn btn-config-catalog w-100 text-start">Grupos de características</a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="Caracteristicas" asp-action="Index" class="btn btn-config-catalog w-100 text-start">Características</a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="Consultores" asp-action="Index" class="btn btn-config-catalog w-100 text-start">Consultores</a>
        </div>
    </div>
</div>