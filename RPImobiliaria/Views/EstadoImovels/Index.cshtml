@model IEnumerable<RPImobiliaria.Models.EstadoImovel>

@{
    ViewData["Title"] = "Estados Físicos dos Imóveis";
}

<div class="container mt-4 mb-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-body-emphasis">
                <i class="bi bi-tools text-primary me-2"></i> @ViewData["Title"]
            </h2>
            <p class="text-body-secondary mb-0">Gestão do estado de conservação físico dos imóveis</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm px-3 py-2">
                <i class="bi bi-plus-lg me-1"></i> Adicionar Novo
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 border-secondary-subtle mb-4 bg-white">
        <div class="card-body p-3 bg-white rounded">
            <form asp-action="Index" method="get">
                <div class="input-group">
                    <span class="input-group-text bg-white border-secondary-subtle text-dark">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-secondary-subtle bg-white text-dark" placeholder="Pesquisar por nome do estado físico..." />
                    <button type="submit" class="btn btn-primary fw-bold px-4">Procurar</button>
                    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold">Limpar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 border-secondary-subtle overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table align-middle mb-0 bg-white text-dark">
                <thead class="bg-light border-bottom border-secondary-subtle">
                    <tr>
                        <th class="py-3 px-4 text-dark text-uppercase small fw-bold" style="width: 100px;">ID</th>
                        <th class="py-3 px-4 text-dark text-uppercase small fw-bold">
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="text-decoration-none text-dark fw-bold d-inline-flex align-items-center gap-1">
                                Nome do Estado Físico
                                <i class="bi bi-arrow-down-up opacity-50 ms-1"></i>
                            </a>
                        </th>
                        <th class="py-3 pe-4 text-dark text-uppercase small fw-bold text-end" style="width: 180px;">Ações</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-dark bg-white">
                                <i class="bi bi-inbox fs-2 mb-2 d-block opacity-50"></i>
                                Nenhum estado físico encontrado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="border-bottom border-secondary-subtle bg-white">
                                <td class="px-4 fw-mono bg-white">
                                    <span class="badge bg-dark text-white border border-secondary">#@item.Id</span>
                                </td>
                                <td class="px-4 fw-bold text-dark bg-white">
                                    @item.Nome
                                </td>
                                <td class="pe-4 text-end bg-white">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Detalhes">
                                            <i class="bi bi-info-circle"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Apagar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>