@model RPImobiliaria.Models.EstadoImovel
@{ ViewData["Title"] = "Apagar estado"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-6"><div class="card border-danger shadow-sm"><div class="card-body p-4"><i class="bi bi-exclamation-triangle text-danger fs-2"></i><h1 class="h4 fw-bold mt-2">Apagar “@Model.Nome”?</h1><p class="text-body-secondary">Existem <strong>@(ViewBag.TotalImoveis ?? 0)</strong> imóvel(is) com este estado. O sistema não permite apagar estados em utilização.</p><form asp-action="Delete"><input asp-for="Id" type="hidden" /><a asp-action="Index" class="btn btn-light border">Cancelar</a><button type="submit" class="btn btn-danger">Apagar estado</button></form></div></div></div></div></div>
