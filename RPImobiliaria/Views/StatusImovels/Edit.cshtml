@model RPImobiliaria.Models.StatusImovel

@{
    ViewData["Title"] = "Editar Estado do Imóvel";
    var corAtual = string.IsNullOrWhiteSpace(Model?.CorHex) ? "#fd7e14" : Model.CorHex;
}

<div class="container mt-4 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="mb-4 text-center">
            <h2 class="fw-bold mb-1 text-body-emphasis">
                <i class="bi bi-pencil-square text-primary me-2"></i> @ViewData["Title"]
            </h2>
            <p class="text-body-secondary mb-0">Atualize as opções, etiqueta e cor deste registo.</p>
        </div>

        <div class="card shadow-sm border-0 border-top border-5 border-primary">
            <div class="card-body p-4 p-md-5">

                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                    <input type="hidden" asp-for="Id" />

                    <!-- Nome do Estado -->
                    <div class="form-floating mb-4">
                        <input asp-for="Nome" id="inputNome" class="form-control form-control-lg border-primary shadow-sm bg-white text-dark" placeholder="Nome da opção" autofocus />
                        <label asp-for="Nome" class="text-dark fw-bold">Nome do Estado do Imóvel <span class="text-danger">*</span></label>
                        <span asp-validation-for="Nome" class="text-danger small fw-bold"></span>
                    </div>

                    <!-- Switch Tem Etiqueta -->
                    <div class="form-check form-switch p-3 bg-white rounded border border-secondary-subtle mb-4 shadow-sm">
                        <input class="form-check-input ms-0 me-3" type="checkbox" asp-for="TemEtiqueta" id="chkTemEtiqueta" style="cursor: pointer; transform: scale(1.2);" />
                        <label class="form-check-label text-dark fw-bold" for="chkTemEtiqueta" style="cursor: pointer;">
                            <i class="bi bi-tag-fill text-primary me-1"></i> Apresentar etiqueta / faixa visual nos anúncios
                        </label>
                    </div>

                    <!-- Bloco Seletor de Cor (visível quando TemEtiqueta = true) -->
                    <div id="blocoCorEtiqueta" class="mb-4 p-3 bg-white border border-secondary-subtle rounded shadow-sm" style="display: none;">
                        <label asp-for="CorHex" class="form-label text-dark fw-bold small text-uppercase mb-2">Cor da Etiqueta</label>
                        <div class="d-flex align-items-center gap-3">
                            <input asp-for="CorHex" type="color" class="form-control form-control-color border border-secondary-subtle" id="corPicker" value="@corAtual" title="Escolha a cor da etiqueta" />
                            <input type="text" id="corTextoHex" class="form-control text-uppercase fw-bold bg-white text-dark border-secondary-subtle" style="max-width: 120px;" readonly value="@corAtual.ToUpper()" />
                            <span id="previewBadge" class="badge px-3 py-2 text-white shadow-sm fw-bold ms-auto" style="background-color: @corAtual; font-size: 0.85rem;">
                                @(string.IsNullOrWhiteSpace(Model?.Nome) ? "Exemplo de Etiqueta" : Model.Nome)
                            </span>
                        </div>
                        <span asp-validation-for="CorHex" class="text-danger small fw-bold"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4 shadow-sm">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Guardar Alterações
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const chk = document.getElementById('chkTemEtiqueta');
        const blocoCor = document.getElementById('blocoCorEtiqueta');
        const picker = document.getElementById('corPicker');
        const txtCor = document.getElementById('corTextoHex');
        const inputNome = document.getElementById('inputNome');
        const preview = document.getElementById('previewBadge');

        function toggleCor() {
            blocoCor.style.display = chk.checked ? '' : 'none';
        }

        function atualizarPreview() {
            const texto = inputNome.value.trim();
            preview.innerText = texto.length > 0 ? texto : 'Exemplo de Etiqueta';
            preview.style.backgroundColor = picker.value;
            txtCor.value = picker.value.toUpperCase();
        }

        chk.addEventListener('change', toggleCor);
        picker.addEventListener('input', atualizarPreview);
        inputNome.addEventListener('input', atualizarPreview);

        // Estado inicial
        toggleCor();
        atualizarPreview();
    </script>
}