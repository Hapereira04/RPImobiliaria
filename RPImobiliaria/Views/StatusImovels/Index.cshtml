@model IEnumerable<dynamic>

@{
    // Mude este título conforme a tabela onde está a colar!
    ViewData["Title"] = "Tabela de Configuração Status Imovel";
}

<div class="container mt-4 mb-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-gear-fill text-primary me-2"></i> @ViewData["Title"]</h2>
            <p class="text-body-secondary mb-0">Gestão de opções e parâmetros do sistema</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Adicionar Novo
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 border-secondary-subtle">
        <div class="table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="bg-body-tertiary border-bottom border-secondary-subtle">
                    <tr>
                        <th class="py-3 text-body-secondary text-uppercase small fw-bold">Status Imovel</th>
                        <th class="py-3 pe-4 text-body-secondary text-uppercase small fw-bold text-end" style="width: 180px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-body-secondary">
                                <i class="bi bi-inbox fs-2 mb-2 d-block"></i>
                                Nenhuma opção registada nesta tabela.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="border-bottom border-secondary-subtle">
                                <td class="fw-bold text-body-emphasis">@item.Nome</td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Detalhes">
                                            <i class="bi bi-info-circle"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Apagar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>