@using Microsoft.AspNetCore.Identity
@using RPImobiliaria.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="pt-PT" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RPImobiliaria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <header class="container-fluid px-2 px-md-3">
        <div class="key-nav-wrapper">

            <div class="key-bg">
                <div class="key-bg-head"></div>
                <div class="key-bg-collar"></div>
                <div class="key-bg-shaft"></div>
                <div class="key-bg-teeth"></div>
            </div>

            <div class="key-content">

                <div class="key-links">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Início</a>

                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Imóveis</a>
                        <ul class="dropdown-menu shadow border-0 mt-3">
                            <li><a class="dropdown-item fw-bold" asp-controller="Imovels" asp-action="Index">Todos os Imóveis</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Imovels" asp-action="Index" asp-route-Negocio="Comprar">Para Comprar</a></li>
                            <li><a class="dropdown-item" asp-controller="Imovels" asp-action="Index" asp-route-Negocio="Arrendar">Para Arrendar</a></li>
                        </ul>
                    </div>

                    <a class="nav-link" asp-controller="Home" asp-action="QuemSomos">Quem Somos</a>
                </div>

                <div class="key-actions">
                    <button type="button" class="btn btn-sm text-white border-0 p-0" id="btnThemeToggle">
                        <i class="bi bi-moon-stars-fill fs-5" id="themeIcon"></i>
                    </button>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown ms-1 ms-md-2">
                            <a class="nav-link dropdown-toggle text-warning fw-bold small p-0" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-badge-fill me-1"></i> <span class="d-none d-sm-inline">@(User.Identity?.Name?.Split('@')[0])</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-4">
                                <li><h6 class="dropdown-header">Painel Privado</h6></li>
                                <li><a class="dropdown-item" asp-controller="Imovels" asp-action="Gestao">Gerir Imóveis</a></li>
                                <li><a class="dropdown-item" asp-controller="Clientes" asp-action="Index">Gerir Clientes (CRM)</a></li>

                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item fw-bold" asp-controller="Backoffice" asp-action="Index">Catálogos e localização</a></li>
                                    <li><a class="dropdown-item text-danger fw-bold" asp-controller="Consultores" asp-action="Index">Gerir equipa</a></li>
                                }

                                <li><hr class="dropdown-divider" /></li>
                                <li><h6 class="dropdown-header">A Minha Conta</h6></li>
                                <li>
                                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                        <i class="bi bi-person-gear text-primary me-2"></i> O Meu Perfil
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                                        <i class="bi bi-key-fill text-warning me-2"></i> Alterar Palavra-passe
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger fw-bold">
                                            <i class="bi bi-box-arrow-right me-2"></i> Terminar Sessão
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>

        </div>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer-rp py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-6">
                    <h5 class="text-white fw-bold mb-3"><i class="bi bi-geo-alt-fill text-primary me-2"></i> Onde Estamos</h5>
                    <div class="rounded overflow-hidden shadow-sm" style="height: 220px;">
                        <iframe src="https://googleusercontent.com/maps.google.com/2"
                                class="w-100 h-100" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="row text-start text-lg-end">

                        <div class="col-md-6 mb-4">
                            <h5 class="text-white fw-bold mb-3">Navegação</h5>
                            <ul class="list-unstyled space-y-2">
                                <li><a href="/" class="footer-link">Início</a></li>
                                <li><a asp-controller="Imovels" asp-action="Index" class="footer-link">Imóveis</a></li>
                                <li><a asp-controller="Home" asp-action="QuemSomos" class="footer-link">Quem Somos</a></li>
                                <li><a href="#" class="footer-link">Política de Privacidade</a></li>
                                <li><a href="#" class="footer-link">Política de Cookies</a></li>
                                <li><a href="https://www.livroreclamacoes.pt/" target="_blank" class="footer-link text-warning"><i class="bi bi-book small me-1"></i> Livro de Reclamações Online</a></li>
                            </ul>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="mb-3">
                                <img src="/images/logo.png" alt="Logo RP Imobiliária" style="max-height: 55px;" onerror="this.style.display='none'" />
                                <h4 class="text-white fw-bold mb-0 mt-2">RP Mediação Imobiliária</h4>
                                <span class="text-muted small">AMI: 12345</span>
                            </div>

                            <div class="d-flex gap-2 justify-content-start justify-content-lg-end mt-3">
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-facebook"></i></a>
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-instagram"></i></a>
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-linkedin"></i></a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="border-top border-secondary mt-4 pt-3 text-center text-muted small">
                © @DateTime.Now.Year - RPImobiliaria. Todos os direitos reservados.
            </div>
        </div>
    </footer>

    <a href="tel:+351999999999" class="btn-floating-contact d-md-none">
        <i class="bi bi-telephone-fill"></i>
    </a>
    <button type="button" class="btn-floating-contact border-0 d-none d-md-flex" data-bs-toggle="modal" data-bs-target="#contactModalGlobal">
        <i class="bi bi-envelope-paper-fill"></i>
    </button>

    <div class="modal fade" id="contactModalGlobal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-chat-dots-fill me-2"></i> Fale Connosco</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center mb-3">
                        <i class="bi bi-telephone-inbound text-success fs-1"></i>
                        <h4 class="fw-bold mt-1">+351 999 999 999</h4>
                        <p class="text-muted small">Prefere mensagem? Preencha os campos abaixo:</p>
                    </div>

                    <form asp-controller="Home" asp-action="EnviarContacto" method="post">
                        <div class="form-floating mb-2">
                            <input type="text" class="form-control" name="Nome" placeholder="O seu nome" required />
                            <label>O seu Nome</label>
                        </div>
                        <div class="form-floating mb-2">
                            <input type="text" class="form-control" name="Contacto" placeholder="Telefone ou Email" required />
                            <label>Telefone ou Email</label>
                        </div>
                        <div class="form-floating mb-2">
                            <input type="text" class="form-control" name="Assunto" placeholder="Assunto" />
                            <label>Assunto / Ref. Imóvel</label>
                        </div>
                        <div class="form-floating mb-4">
                            <textarea class="form-control" name="Mensagem" placeholder="A sua mensagem" style="height: 100px" required></textarea>
                            <label>A sua mensagem...</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold btn-lg">
                            Enviar Mensagem <i class="bi bi-send ms-1"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 1080;">
        @if (TempData["MensagemSucesso"] != null)
        {
            <div id="emailToast" class="toast align-items-center text-white bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="10000">
                <div class="d-flex">
                    <div class="toast-body fw-bold fs-6">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["MensagemSucesso"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-3 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div id="emailToast" class="toast align-items-center text-white bg-danger border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="10000">
                <div class="d-flex">
                    <div class="toast-body fw-bold fs-6">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["MensagemErro"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-3 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["MensagemErro"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                alert("@TempData["MensagemErro"]");
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>