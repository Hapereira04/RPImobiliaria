@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="pt-PT" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RPImobiliaria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            /* FIX DE LAYOUT */
            html, body {
                height: 100%;
                margin: 0;
                padding: 0;
                overflow-x: hidden;
            }

            /* MODOS CLARO / ESCURO */
            [data-bs-theme="light"] body {
                background-color: #ffffff !important;
                color: #212529;
            }

            [data-bs-theme="light"] .key-bg-head::after {
                background-color: #ffffff !important;
            }

            [data-bs-theme="dark"] body {
                background-color: #2b2d31 !important;
                color: #f2f3f5;
            }

            [data-bs-theme="dark"] .key-bg-head::after {
                background-color: #2b2d31 !important;
            }

            /* ====================================================
                       A CHAVE REALISTA (Baseada na tua Imagem!)
                       ==================================================== */
            .key-nav-wrapper {
                position: relative;
                max-width: 1050px;
                margin: 20px auto 40px auto;
                height: 120px;
                display: flex;
                align-items: center;
                filter: drop-shadow(0 15px 20px rgba(0,0,0,0.25));
            }

            /* O FUNDO DA CHAVE */
            .key-bg {
                position: absolute;
                inset: 0;
                z-index: 1;
                pointer-events: none;
            }

            .key-bg-head {
                position: absolute;
                left: 0;
                top: 0;
                width: 120px;
                height: 120px;
                background-color: #111111;
                border-radius: 50%;
            }

                .key-bg-head::after {
                    content: '';
                    position: absolute;
                    left: 20px;
                    top: 40px;
                    width: 40px;
                    height: 40px;
                    background-color: var(--bs-body-bg);
                    border-radius: 50%;
                    box-shadow: inset 0 5px 10px rgba(0,0,0,0.5);
                }

            .key-bg-collar {
                position: absolute;
                left: 105px;
                top: 15px;
                width: 30px;
                height: 90px;
                background-color: #111111;
                clip-path: polygon(0 25%, 50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%);
            }

            /* O Bico da chave (menos agressivo para proteger os botões) */
            .key-bg-shaft {
                position: absolute;
                left: 130px;
                right: 0;
                top: 30px;
                height: 60px;
                background-color: #111111;
                clip-path: polygon(0 0, 95% 0, 100% 50%, 95% 100%, 0 100%);
            }

            /* DENTES RETANGULARES VARIADOS (Como uma chave de casa verdadeira) */
            .key-bg-teeth {
                position: absolute;
                right: 100px;
                top: 89px;
                width: 160px;
                height: 25px;
                background-color: #111111;
                /* Cortes a 90 graus (retângulos com alturas sortidas) */
                clip-path: polygon( 0 0, 100% 0, 100% 30%, 92% 30%, 92% 10%, 84% 10%, 84% 90%, 74% 90%, 74% 10%, 66% 10%, 66% 50%, 56% 50%, 56% 10%, 48% 10%, 48% 100%, 38% 100%, 38% 10%, 30% 10%, 30% 70%, 20% 70%, 20% 10%, 12% 10%, 12% 80%, 2% 80%, 2% 10%, 0 10% );
            }

            /* ====================================================
                       O CONTEÚDO (MENUS NO CENTRO, BOTÕES PROTEGIDOS)
                       ==================================================== */
            .key-content {
                position: relative;
                z-index: 2;
                width: 100%;
                display: flex;
                align-items: center;
                padding-left: 140px; /* Barreira da argola redonda */
                padding-right: 75px; /* BARREIRA DO BICO - Protege os botões para nunca saírem para fora! */
            }

            .key-links {
                margin: 0 auto; /* Magia para centrar perfeitamente no espaço sobrante */
                display: flex;
                gap: 20px;
                align-items: center;
            }

                .key-links .nav-link {
                    color: #ffffff !important;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    font-size: 0.95rem;
                    padding: 5px 10px;
                    transition: color 0.2s ease;
                }

                    .key-links .nav-link:hover {
                        color: #ffc107 !important;
                    }

            .key-actions {
                display: flex;
                align-items: center;
                gap: 15px;
                /* Empurrado naturalmente para a direita pelo 'margin: 0 auto' dos links */
            }

            /* ====================================================
                       ADAPTAÇÃO MOBILE (ESCADINHA DE RETÂNGULOS)
                       ==================================================== */
            @@media (max-width: 991px) {
                .key-nav-wrapper {
                    height: 80px;
                    margin: 10px auto 30px auto;
                }

                .key-bg-head {
                    width: 80px;
                    height: 80px;
                }

                    .key-bg-head::after {
                        left: 12px;
                        top: 25px;
                        width: 30px;
                        height: 30px;
                    }

                .key-bg-collar {
                    left: 70px;
                    top: 10px;
                    width: 20px;
                    height: 60px;
                }

                .key-bg-shaft {
                    left: 85px;
                    top: 20px;
                    height: 40px;
                    clip-path: polygon(0 0, 92% 0, 100% 50%, 92% 100%, 0 100%);
                }

                .key-bg-teeth {
                    right: 90px;
                    top: 59px;
                    width: 110px;
                    height: 18px;
                    /* MOBILE: Retângulos em escadinha! */
                    clip-path: polygon( 0 0, 100% 0, 100% 30%, 92% 30%, 92% 10%, 84% 10%, 84% 90%, 74% 90%, 74% 10%, 66% 10%, 66% 50%, 56% 50%, 56% 10%, 48% 10%, 48% 100%, 38% 100%, 38% 10%, 30% 10%, 30% 70%, 20% 70%, 20% 10%, 12% 10%, 12% 80%, 2% 80%, 2% 10%, 0 10% );
                }
                /* Ajustes de Padding no Mobile para proteger os botões */
                .key-content {
                    padding-left: 90px;
                    padding-right: 40px;
                }

                .key-links {
                    gap: 5px;
                }

                    .key-links .nav-link {
                        font-size: 0.7rem !important;
                        padding: 3px 5px;
                        letter-spacing: 0;
                    }

                .key-actions {
                    gap: 5px;
                }

                .dropdown-menu {
                    font-size: 0.85rem;
                }
            }

            @@media (max-width: 480px) {
                .key-links {
                    gap: 2px;
                }

                    .key-links .nav-link {
                        font-size: 0.6rem !important;
                    }

                .key-content {
                    padding-right: 30px;
                    padding-left: 80px;
                }

                .key-bg-teeth {
                    right: 25px;
                    width: 85px;
                }
            }

            /* ====================================================
                       RODAPÉ E BOTÕES GLOBAIS
                       ==================================================== */
            .btn-floating-contact {
                position: fixed;
                bottom: 25px;
                right: 25px;
                width: 60px;
                height: 60px;
                border-radius: 50%;
                background-color: #25d366;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.3);
                z-index: 1000;
                transition: transform 0.2s ease;
                text-decoration: none;
            }

                .btn-floating-contact:hover {
                    transform: scale(1.1);
                    color: white;
                }

            .footer-rp {
                background-color: #121212;
                color: #d0d0d0;
                margin-top: auto;
            }

            .footer-link {
                color: #909090;
                text-decoration: none;
                transition: color 0.2s;
            }

                .footer-link:hover {
                    color: #ffffff;
                }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- HEADER: A CHAVE -->
    <header class="container-fluid px-2 px-md-3">
        <div class="key-nav-wrapper">

            <!-- O FUNDO DESENHADO -->
            <div class="key-bg">
                <div class="key-bg-head"></div>
                <div class="key-bg-collar"></div>
                <div class="key-bg-shaft"></div>
                <div class="key-bg-teeth"></div>
            </div>

            <!-- OS MENUS E BOTÕES (Protegidos pelo padding) -->
            <div class="key-content">

                <!-- ATALHOS (No Centro Automático) -->
                <div class="key-links">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Início</a>

                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Imóveis</a>
                        <ul class="dropdown-menu shadow border-0 mt-3">
                            <li><a class="dropdown-item fw-bold" asp-controller="Imovels" asp-action="Index">Todos os Imóveis</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Imovels?negocio=comprar">Para Comprar</a></li>
                            <li><a class="dropdown-item" href="/Imovels?negocio=arrendar">Para Arrendar</a></li>
                        </ul>
                    </div>

                    <a class="nav-link" asp-controller="Home" asp-action="QuemSomos">Quem Somos</a>
                </div>

                <!-- AÇÕES (Fixas com segurança à direita) -->
                <div class="key-actions">
                    <button type="button" class="btn btn-sm text-white border-0 p-0" id="btnThemeToggle">
                        <i class="bi bi-moon-stars-fill fs-5" id="themeIcon"></i>
                    </button>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown ms-1 ms-md-2">
                            <a class="nav-link dropdown-toggle text-warning fw-bold small p-0" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-badge-fill me-1"></i> <span class="d-none d-sm-inline">@User.Identity?.Name?.Split('@')[0]</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-4">
                                <li><h6 class="dropdown-header">Painel Privado</h6></li>
                                <li><a class="dropdown-item" asp-controller="Imovels" asp-action="Gestao">Gerir Imóveis</a></li>
                                <li><a class="dropdown-item" asp-controller="Clientes" asp-action="Index">Gerir Clientes (CRM)</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger fw-bold" asp-controller="Consultors" asp-action="Index">Equipa & Definições</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">Terminar Sessão</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>

        </div>
    </header>

    <!-- CONTEÚDO PRINCIPAL -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER RP IMOBILIÁRIA -->
    <footer class="footer-rp py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-6">
                    <h5 class="text-white fw-bold mb-3"><i class="bi bi-geo-alt-fill text-primary me-2"></i> Onde Estamos</h5>
                    <div class="rounded overflow-hidden shadow-sm" style="height: 220px;">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d48259.049448839075!2d-8.66578051770932!3d40.85764426861214!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd23838dc2a0ec43%3A0xbcc0e84b729d3bd!2sOvar!5e0!3m2!1spt-PT!2spt!4v1717000000000!5m2!1spt-PT!2spt"
                                width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>

                <!-- Direita: Links e Contactos (Alinhados à direita no PC, à esquerda no Mobile) -->
                <div class="col-lg-6">
                    <div class="row text-start text-lg-end">

                        <div class="col-md-6 mb-4">
                            <h5 class="text-white fw-bold mb-3">Navegação</h5>
                            <ul class="list-unstyled space-y-2">
                                <li><a href="/" class="footer-link">Início</a></li>
                                <li><a asp-controller="Imovels" asp-action="Index" class="footer-link">Imóveis</a></li>
                                <li><a asp-controller="Home" asp-action="QuemSomos" class="footer-link">Quem Somos</a></li>
                                <li><a href="#" class="footer-link">Política de Privacidade</a></li>
                                <li><a href="#" class="footer-link">Política de Cookies</a></li>
                                <li><a href="https://www.livroreclamacoes.pt/" target="_blank" class="footer-link text-warning"><i class="bi bi-book small me-1"></i> Livro de Reclamações Online</a></li>
                            </ul>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="mb-3">
                                <img src="/images/logo.png" alt="Logo RP Imobiliária" style="max-height: 55px;" onerror="this.style.display='none'">
                                <h4 class="text-white fw-bold mb-0 mt-2">RP Mediação Imobiliária</h4>
                                <span class="text-muted small">AMI: 12345</span>
                            </div>

                            <!-- As redes sociais também saltam para a direita no PC -->
                            <div class="d-flex gap-2 justify-content-start justify-content-lg-end mt-3">
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-facebook"></i></a>
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-instagram"></i></a>
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-linkedin"></i></a>
                            </div>
                        </div>

                    </div>
                </div>
                </div>
            </div>
            <div class="border-top border-secondary mt-4 pt-3 text-center text-muted small">
                &copy; @DateTime.Now.Year - RPImobiliaria. Todos os direitos reservados.
            </div>
        </div>
    </footer>

    <!-- BOTÃO FLUTUANTE DE CONTACTO -->
    <a href="tel:+351999999999" class="btn-floating-contact d-md-none">
        <i class="bi bi-telephone-fill"></i>
    </a>
    <button type="button" class="btn-floating-contact border-0 d-none d-md-flex" data-bs-toggle="modal" data-bs-target="#contactModalGlobal">
        <i class="bi bi-envelope-paper-fill"></i>
    </button>

    <!-- MODAL DE CONTACTO -->
    <div class="modal fade" id="contactModalGlobal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-chat-dots-fill me-2"></i> Fale Connosco</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center mb-3">
                        <i class="bi bi-telephone-inbound text-success fs-1"></i>
                        <h4 class="fw-bold mt-1">+351 999 999 999</h4>
                        <p class="text-muted small">Prefere mensagem? Preencha os campos abaixo:</p>
                    </div>

                    <form asp-controller="Home" asp-action="EnviarContacto" method="post">
                        <div class="form-floating mb-2">
                            <input type="text" class="form-control" name="Nome" placeholder="O seu nome" required>
                            <label>O seu Nome</label>
                        </div>
                        <div class="form-floating mb-2">
                            <input type="text" class="form-control" name="Contacto" placeholder="Telefone ou Email" required>
                            <label>Telefone ou Email</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" name="Assunto" placeholder="Assunto">
                            <label>Assunto / Ref. Imóvel</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold btn-lg">
                            Enviar Mensagem <i class="bi bi-send ms-1"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- SCRIPT TEMA -->
    <script>
            document.addEventListener("DOMContentLoaded", () => {
                const htmlEl = document.documentElement;
                const btnToggle = document.getElementById("btnThemeToggle");
                const iconToggle = document.getElementById("themeIcon");

                function getPreferredTheme() {
                    const saved = localStorage.getItem("theme");
                    if (saved) return saved;
                    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }

                function applyTheme(theme) {
                    htmlEl.setAttribute("data-bs-theme", theme);
                    localStorage.setItem("theme", theme);
                    if (theme === "dark") {
                        iconToggle.className = "bi bi-sun-fill text-warning fs-5";
                    } else {
                        iconToggle.className = "bi bi-moon-stars-fill text-white fs-5";
                    }
                }

                applyTheme(getPreferredTheme());

                window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
                    if (!localStorage.getItem("theme")) applyTheme(e.matches ? "dark" : "light");
                });

                btnToggle.addEventListener("click", () => {
                    const current = htmlEl.getAttribute("data-bs-theme");
                    applyTheme(current === "dark" ? "light" : "dark");
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>