@model IEnumerable<RPImobiliaria.Models.Imovel>
@{
    ViewData["Title"] = "Página Inicial";
}

<!-- ESTILOS EXCLUSIVOS DA PÁGINA INICIAL -->
<style>
    /* GARANTE A COR DO TÍTULO NO MODO ESCURO E CLARO */
    [data-bs-theme="light"] .destaques-title {
        color: #212529 !important;
    }

    [data-bs-theme="dark"] .destaques-title {
        color: #ffffff !important;
    }

    /* HERO SECTION (Vídeo de Fundo) */
    .hero-section {
        position: relative;
        height: 85vh;
        width: 100%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: -20px;
    }

    #bg-video {
        position: absolute;
        top: 50%;
        left: 50%;
        min-width: 100%;
        min-height: 100%;
        width: auto;
        height: auto;
        transform: translateX(-50%) translateY(-50%);
        z-index: 0;
        object-fit: cover;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.7) 100%);
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        color: white;
        padding: 20px;
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
    }

    .hero-subtitle {
        font-size: 1.2rem;
        font-weight: 300;
        margin-bottom: 30px;
        text-shadow: 1px 1px 5px rgba(0,0,0,0.5);
    }

    /* CARROSSEL DE DESTAQUES */
    .destaques-section {
        padding: 80px 0;
        background-color: transparent;
    }

    /* O CARTÃO CLICÁVEL (Corta as curvas na perfeição) */
    .destaque-link {
        display: block;
        text-decoration: none;
        position: relative;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        background-color: transparent;
        overflow: hidden;
        transform: translateZ(0);
    }

    .carousel-item img {
        height: 500px;
        width: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    /* Banner a flutuar no PC (Tem os seus próprios cantos redondos) */
    .imovel-card-overlay {
        position: absolute;
        bottom: 20px;
        left: 20px;
        right: 20px;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(5px);
        padding: 20px;
        border-radius: 10px;
        color: white;
        transition: background-color 0.3s ease;
    }

    .destaque-link:hover .imovel-card-overlay {
        background: rgba(0, 0, 0, 0.90);
    }

    .preco-destaque {
        font-size: 1.8rem;
        font-weight: 700;
        color: #25d366;
    }

    /* ADAPTAÇÃO MOBILE */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2rem;
        }

        .carousel-item img {
            height: 350px;
        }
        /* Banner colado abaixo da foto no telemóvel */
        .imovel-card-overlay {
            position: relative;
            bottom: 0;
            left: 0;
            right: 0;
            border-radius: 0;
            margin-top: -1px;
        }
    }
</style>

<!-- 1. ZONA DO VÍDEO (HERO) -->
<section class="hero-section">
    <!-- VÍDEO MP4 -->
    <video autoplay loop muted playsinline id="bg-video">
        <source src="~/videos/ovar-zoom.mp4" type="video/mp4">
    </video>

    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1 class="hero-title">Ovar é a nossa Casa</h1>
        <p class="hero-subtitle">Encontre o imóvel dos seus sonhos com a RP Mediação Imobiliária.</p>

        <div class="d-flex gap-3 justify-content-center mt-4">
            <a href="/Imovels?negocio=comprar" class="btn btn-primary btn-lg fw-bold px-4 rounded-pill shadow">
                Comprar <i class="bi bi-house-door-fill ms-2"></i>
            </a>
            <a href="/Imovels?negocio=arrendar" class="btn btn-outline-light btn-lg fw-bold px-4 rounded-pill">
                Arrendar <i class="bi bi-key-fill ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- 2. ZONA DOS IMÓVEIS EM DESTAQUE -->
<section class="destaques-section">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold destaques-title">Imóveis em Destaque</h2>
            <div class="mx-auto mt-2" style="height: 4px; width: 60px; background-color: var(--bs-primary); border-radius: 2px;"></div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div id="carroselDestaques" class="carousel slide carousel-fade" data-bs-ride="carousel">
                <div class="carousel-inner">

                    @{
                        var index = 0;
                    }
                    @foreach (var imovel in Model)
                    {
                        var imagemDestaque = imovel.Fotos?.OrderBy(f => f.Ordem).FirstOrDefault()?.CaminhoImagem ?? "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80";
                        var nomeFreguesia = imovel.Freguesia?.Nome;
                        var nomeConcelho = imovel.Concelho?.Nome ?? imovel.Freguesia?.Concelho?.Nome;
                        var nomeDistrito = imovel.Distrito?.Nome ?? imovel.Freguesia?.Concelho?.Distrito?.Nome;

                        var locParts = new List<string>();
                        if (!string.IsNullOrWhiteSpace(nomeFreguesia)) locParts.Add(nomeFreguesia);
                        if (!string.IsNullOrWhiteSpace(nomeConcelho)) locParts.Add(nomeConcelho);
                        if (!string.IsNullOrWhiteSpace(nomeDistrito)) locParts.Add(nomeDistrito);

                        var localizacao = locParts.Any() ? string.Join(", ", locParts.Distinct()) : "Localização por indicar";
                        <div class="carousel-item @(index == 0 ? "active" : "")" data-bs-interval="5000">
                            <a asp-controller="Imovels" asp-action="Details" asp-route-id="@imovel.Id" class="destaque-link">
                                <img src="@imagemDestaque" alt="@imovel.Titulo">
                                <div class="imovel-card-overlay">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                                        <div>
                                            <span class="badge bg-primary mb-2">@(imovel.TipoNegocio?.Nome ?? "Destaque")</span>
                                            <h3 class="mb-1 fw-bold">@imovel.Titulo</h3>
                                            <p class="mb-0 text-light"><i class="bi bi-geo-alt-fill text-danger"></i> @localizacao</p>
                                        </div>
                                        <div class="text-end mt-2 mt-md-0">
                                            <div class="preco-destaque">@imovel.Preco.ToString("N0") €</div>
                                            <span class="btn btn-sm btn-light fw-bold mt-2">Ver Detalhes</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        index++;
                    }

                </div>

                @if (Model.Count() > 1)
                {
                    <!-- Botões de Navegação -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#carroselDestaques" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carroselDestaques" data-bs-slide="next">
                        <span class="carousel-control-next-icon bg-dark rounded-circle p-3" aria-hidden="true"></span>
                        <span class="visually-hidden">Próximo</span>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted p-5 bg-body-tertiary rounded-4">
                <i class="bi bi-stars display-4 mb-3 opacity-50"></i>
                <h5>Ainda não existem imóveis em destaque.</h5>
                <p>Os imóveis selecionados pela equipa aparecerão aqui.</p>
            </div>
        }

        <div class="text-center mt-5">
            <a asp-controller="Imovels" asp-action="Index" class="btn btn-outline-primary btn-lg fw-bold">
                Ver todos os Imóveis <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- 3. ZONA DE CONTACTO GLOBAL -->
<section class="contacto-section py-5 bg-dark text-white">
    <div class="container py-4">
        <div class="row align-items-center g-5">

            <!-- Texto e Informações -->
            <div class="col-lg-6">
                <h2 class="fw-bold mb-4">Fale com um Especialista</h2>
                <p class="text-light mb-4 fs-5">
                    Tem dúvidas sobre um imóvel ou quer vender a sua casa? Deixe-nos a sua mensagem. A nossa equipa entrará em contacto consigo o mais breve possível.
                </p>

                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary rounded-circle me-3 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 60px; height: 60px; flex-shrink: 0;">
                        <i class="bi bi-telephone-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold">Ligue-nos</h5>
                        <span class="text-light">+351 934 192 147</span>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary rounded-circle me-3 d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 60px; height: 60px; flex-shrink: 0;">
                        <i class="bi bi-geo-alt-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold">Visite-nos</h5>
                        <span class="text-light">Centro Comercial Garrett</span>
                    </div>
                </div>
            </div>

            <!-- Formulário -->
            <div class="col-lg-6">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-lg text-dark">
                    <h4 class="fw-bold mb-4 text-center">Envie uma Mensagem</h4>

                    <form asp-controller="Home" asp-action="EnviarContacto" method="post">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control bg-light" name="Nome" placeholder="O seu nome" required>
                            <label>O seu Nome</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="text" class="form-control bg-light" name="Contacto" placeholder="Telefone ou Email" required>
                            <label>Telefone ou Email</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="text" class="form-control bg-light" name="Assunto" placeholder="Assunto ou Referência">
                            <label>Assunto / Ref. Imóvel</label>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea class="form-control bg-light" name="Mensagem" placeholder="A sua mensagem" style="height: 120px" required></textarea>
                            <label>A sua mensagem...</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold btn-lg">
                            Enviar Mensagem <i class="bi bi-send ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>