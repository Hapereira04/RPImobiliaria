@model RPImobiliaria.Models.Concelho
@{ ViewData["Title"] = "Novo concelho"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-6"><a asp-action="Index" class="btn btn-link px-0 mb-3"><i class="bi bi-arrow-left"></i> Voltar</a><div class="card border-0 shadow-sm"><div class="card-body p-4"><h1 class="h3 fw-bold">Novo concelho</h1><form asp-action="Create"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-floating mb-3"><select asp-for="DistritoId" asp-items="ViewBag.DistritoId" class="form-select"><option value="">Selecione o distrito</option></select><label asp-for="DistritoId">Distrito</label><span asp-validation-for="DistritoId" class="text-danger small"></span></div><div class="form-floating mb-4"><input asp-for="Nome" class="form-control" placeholder="Nome" autofocus /><label asp-for="Nome">Nome do concelho</label><span asp-validation-for="Nome" class="text-danger small"></span></div><button class="btn btn-primary" type="submit">Guardar concelho</button></form></div></div></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
