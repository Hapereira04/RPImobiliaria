@model RPImobiliaria.Models.Concelho
@{ ViewData["Title"] = Model.Nome; }
<div class="container py-4"><a asp-action="Index" class="btn btn-link px-0 mb-3"><i class="bi bi-arrow-left"></i> Concelhos</a><div class="card border-0 shadow-sm"><div class="card-body p-4"><div class="d-flex justify-content-between gap-3"><div><p class="text-uppercase text-body-secondary small fw-bold mb-1">@Model.Distrito.Nome</p><h1 class="h3 fw-bold">@Model.Nome</h1></div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary align-self-start">Editar</a></div><hr /><h2 class="h5 fw-bold">Freguesias (@Model.Freguesias.Count)</h2>@if (Model.Freguesias.Any()) { <div class="d-flex flex-wrap gap-2">@foreach (var freguesia in Model.Freguesias.OrderBy(f => f.Nome)) { <span class="badge text-bg-light border fw-normal">@freguesia.Nome</span> }</div> } else { <p class="text-body-secondary mb-0">Ainda não existem freguesias associadas.</p> }</div></div></div>
