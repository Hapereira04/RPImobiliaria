@model RPImobiliaria.Models.Consultor

@{
    ViewData["Title"] = "Detalhes do Consultor";
    var imoveis = Model?.ImoveisAngariados ?? new List<RPImobiliaria.Models.Imovel>();
}

<div class="container mt-4 mb-5 d-flex justify-content-center">
    <div class="col-md-9 col-lg-8">

        <div class="mb-4 text-center">
            <h2 class="fw-bold mb-1 text-body-emphasis">
                <i class="bi bi-person-badge-fill text-primary me-2"></i> @ViewData["Title"]
            </h2>
            <p class="text-body-secondary mb-0">Informações de perfil e carteira de imóveis angariados.</p>
        </div>

        <div class="card shadow-sm border-0 border-top border-5 border-primary mb-4">
            <div class="card-body p-4 p-md-5">

                <div class="bg-white p-4 rounded border border-secondary-subtle mb-4">
                    <div class="row g-3 border-bottom border-secondary-subtle pb-3 mb-3">
                        <div class="col-sm-6 border-bottom border-sm-0 border-end-sm border-secondary-subtle pb-3 pb-sm-0">
                            <h6 class="text-dark fw-bold text-uppercase small mb-1">Identificador (ID)</h6>
                            <p class="fs-5 fw-mono text-primary mb-0">#@Model?.Id</p>
                        </div>

                        <div class="col-sm-6">
                            <h6 class="text-dark fw-bold text-uppercase small mb-1">Estado da Conta de Acesso</h6>
                            @if (!string.IsNullOrEmpty(Model?.ApplicationUserId))
                            {
                                <span class="badge bg-success text-white px-3 py-2 fw-bold">
                                    <i class="bi bi-shield-check me-1"></i> Conta de Login Ativa
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 fw-bold">
                                    <i class="bi bi-exclamation-triangle me-1"></i> Sem Acesso Associado
                                </span>
                            }
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-12 mb-2">
                            <h6 class="text-dark fw-bold text-uppercase small mb-1">Nome Completo</h6>
                            <p class="fs-4 fw-bold text-dark mb-0">@Model?.Nome</p>
                        </div>

                        <div class="col-sm-6">
                            <h6 class="text-dark fw-bold text-uppercase small mb-1">Email (Login)</h6>
                            <p class="fs-6 fw-bold text-dark mb-0">
                                <i class="bi bi-envelope-fill text-primary me-1"></i> @(Model?.Email ?? "N/D")
                            </p>
                        </div>

                        <div class="col-sm-6">
                            <h6 class="text-dark fw-bold text-uppercase small mb-1">Telemóvel</h6>
                            <p class="fs-6 fw-bold text-dark mb-0">
                                <i class="bi bi-telephone-fill text-primary me-1"></i> @(Model?.Telemovel ?? "N/D")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-4 rounded border border-secondary-subtle">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 pb-2 border-bottom border-secondary-subtle gap-2">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-houses-fill text-primary me-2"></i> Imóveis Angariados
                        </h5>
                        <span class="badge bg-primary text-white px-3 py-2 fw-bold shadow-sm">
                            @imoveis.Count @(imoveis.Count == 1 ? "Imóvel" : "Imóveis")
                        </span>
                    </div>

                    @if (!imoveis.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 mb-2 d-block opacity-50 text-dark"></i>
                            <span class="text-dark fw-medium d-block">Este consultor ainda não possui imóveis angariados associados.</span>
                        </div>
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-3 mt-2">
                            @foreach (var imovel in imoveis)
                            {
                                <div class="col">
                                    <div class="p-3 bg-light rounded border border-secondary-subtle h-100 d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-dark fs-6">
                                            <i class="bi bi-house text-secondary me-1"></i> @imovel.Titulo
                                        </span>
                                        <span class="badge bg-dark text-white small">
                                            #@imovel.Id
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4 shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary fw-bold px-4 shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Editar Consultor
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>