@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar Palavra-passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="card shadow-sm border-0 border-top border-5 border-warning bg-white text-dark">
    <div class="card-body p-4 p-md-5">

        <h4 class="fw-bold text-dark mb-2">
            <i class="bi bi-key-fill text-warning me-2"></i> @ViewData["Title"]
        </h4>
        <p class="text-secondary small mb-4">Por motivos de segurança, escolha uma palavra-passe forte que inclua letras, números e símbolos.</p>

        <partial name="_StatusMessage" for="StatusMessage" />

        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.OldPassword" class="form-control border-secondary-subtle bg-white text-dark" autocomplete="current-password" aria-required="true" placeholder="Palavra-passe atual" />
                <label asp-for="Input.OldPassword" class="text-dark fw-bold">Palavra-passe Atual</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger small fw-bold"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control border-warning shadow-sm bg-white text-dark" autocomplete="new-password" aria-required="true" placeholder="Nova palavra-passe" />
                <label asp-for="Input.NewPassword" class="text-dark fw-bold">Nova Palavra-passe</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger small fw-bold"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control border-warning shadow-sm bg-white text-dark" autocomplete="new-password" aria-required="true" placeholder="Confirmar nova palavra-passe" />
                <label asp-for="Input.ConfirmPassword" class="text-dark fw-bold">Confirmar Nova Palavra-passe</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small fw-bold"></span>
            </div>

            <button type="submit" class="w-100 btn btn-warning btn-lg fw-bold shadow-sm text-dark">
                <i class="bi bi-check-circle-fill me-1"></i> Atualizar Palavra-passe
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}