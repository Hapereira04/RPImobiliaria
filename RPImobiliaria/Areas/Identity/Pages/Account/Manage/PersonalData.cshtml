@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dados Pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="card shadow-sm border-0 border-top border-5 border-danger bg-white text-dark">
    <div class="card-body p-4 p-md-5">

        <h4 class="fw-bold text-dark mb-2">
            <i class="bi bi-file-earmark-person-fill text-danger me-2"></i> @ViewData["Title"]
        </h4>
        <p class="text-secondary small mb-4">A sua conta contém dados pessoais fornecidos por si. Esta página permite descarregar ou eliminar permanentemente esses dados (Regulamento RGPD).</p>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="p-3 bg-light rounded border border-secondary-subtle h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-download text-primary me-1"></i> Descarregar Dados</h6>
                        <p class="small text-secondary mb-3">Obtenha um ficheiro em formato JSON com todas as informações guardadas sobre a sua conta.</p>
                    </div>
                    <form id="download-data" asp-page="./DownloadPersonalData" method="post">
                        <button class="btn btn-outline-primary fw-bold w-100" type="submit">
                            <i class="bi bi-file-earmark-arrow-down me-1"></i> Descarregar
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-3 bg-light rounded border border-danger-subtle h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h6 class="fw-bold text-danger mb-2"><i class="bi bi-trash3-fill me-1"></i> Eliminar Conta</h6>
                        <p class="small text-secondary mb-3">A eliminação da conta apaga permanentemente todos os seus dados e não pode ser revertida.</p>
                    </div>
                    <a id="delete" asp-page="./DeletePersonalData" class="btn btn-danger fw-bold w-100 shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Apagar Conta
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}