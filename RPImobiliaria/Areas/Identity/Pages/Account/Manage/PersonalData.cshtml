@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dados Pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="fw-bold mb-4">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-8 col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3 text-primary">
                    <i class="bi bi-shield-lock-fill fs-2 me-3"></i>
                    <h5 class="card-title mb-0 fw-bold">A sua privacidade é importante</h5>
                </div>
                <p class="card-text text-muted">
                    A sua conta contém dados pessoais que nos forneceu. Esta página permite-lhe descarregar ou apagar esses dados, em conformidade com o Regulamento Geral sobre a Proteção de Dados (RGPD).
                </p>
                <p class="card-text text-muted mb-4">
                    <strong>Aviso:</strong> Apagar a sua conta é uma ação permanente e não pode ser revertida.
                </p>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
                    <form id="download-data" asp-page="DownloadPersonalData" method="post">
                        <button class="btn btn-outline-primary fw-bold px-4 shadow-sm w-100" type="submit">
                            <i class="bi bi-cloud-download me-2"></i> Descarregar os meus dados
                        </button>
                    </form>

                    <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger fw-bold px-4 shadow-sm">
                        <i class="bi bi-trash3 me-2"></i> Apagar a minha conta
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
