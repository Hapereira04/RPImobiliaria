@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Apagar Conta Pessoal";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="fw-bold mb-4 text-danger">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="alert alert-warning shadow-sm border-0 border-start border-5 border-warning mb-4" role="alert">
            <h5 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Atenção!</h5>
            <p class="mb-0">
                Está prestes a apagar permanentemente a sua conta. Esta ação não pode ser desfeita. Todos os seus dados, histórico e configurações serão perdidos para sempre.
            </p>
        </div>

        <div class="card shadow-sm border-0 border-top border-danger border-3">
            <div class="card-body p-4">
                <form id="delete-user" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    @if (Model.RequirePassword)
                    {
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Por favor, insira a sua palavra-passe." />
                            <label asp-for="Input.Password" class="form-label">Palavra-passe para confirmar</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                    }

                    <button class="btn btn-danger btn-lg w-100 fw-bold shadow-sm" type="submit">
                        <i class="bi bi-person-x-fill me-2"></i> Sim, Apagar Conta e os Meus Dados
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}