@page
@model IndexModel
@{
    ViewData["Title"] = "O Meu Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="fw-bold text-body-emphasis mb-4">@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form id="profile-form" method="post" class="card shadow-sm border-0 border-top border-5 border-primary">
            <div class="card-body p-4 p-md-5">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm" role="alert"></div>

                <div class="form-floating mb-4">
                    <input asp-for="Username" class="form-control border-secondary-subtle bg-light text-muted" placeholder="Email" disabled />
                    <label asp-for="Username" class="text-dark fw-bold">Endereço de Email (Login)</label>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.Nome" class="form-control border-primary shadow-sm bg-white text-dark" placeholder="O seu nome" />
                    <label asp-for="Input.Nome" class="text-dark fw-bold">Nome Completo</label>
                    <span asp-validation-for="Input.Nome" class="text-danger small fw-bold"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.Telemovel" class="form-control border-primary shadow-sm bg-white text-dark" placeholder="O seu telemóvel" />
                    <label asp-for="Input.Telemovel" class="text-dark fw-bold">Telemóvel</label>
                    <span asp-validation-for="Input.Telemovel" class="text-danger small fw-bold"></span>
                </div>

                @if (Model.Input.IsCliente)
                {
                    <div class="form-floating mb-4">
                        <input asp-for="Input.NIF" class="form-control border-primary shadow-sm bg-white text-dark" placeholder="O seu NIF" />
                        <label asp-for="Input.NIF" class="text-dark fw-bold">NIF</label>
                        <span asp-validation-for="Input.NIF" class="text-danger small fw-bold"></span>
                    </div>
                }

                <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary fw-bold shadow-sm">
                    <i class="bi bi-save me-1"></i> Guardar Alterações
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}