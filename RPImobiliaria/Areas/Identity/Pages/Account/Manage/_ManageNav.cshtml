@using RPImobiliaria.Data
@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<ul class="nav nav-pills nav-fill flex-column flex-sm-row gap-2 p-2 bg-body-tertiary rounded border border-secondary-subtle mb-4">
    <li class="nav-item">
        <a class="nav-link fw-bold @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
            <i class="bi bi-person-circle me-1"></i> O Meu Perfil
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link fw-bold @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
            <i class="bi bi-key-fill me-1"></i> Palavra-passe
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link fw-bold @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication">
            <i class="bi bi-shield-lock-fill me-1"></i> 2 Fatores (2FA)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link fw-bold @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">
            <i class="bi bi-file-earmark-person-fill me-1"></i> Dados Pessoais
        </a>
    </li>
</ul>