@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">

            <div class="mb-4 text-center">
                <h2 class="fw-bold mb-1 text-body-emphasis">
                    <i class="bi bi-gear-wide-connected text-primary me-2"></i> Gestão da Conta
                </h2>
                <p class="text-body-secondary mb-0">Atualize as suas informações pessoais, segurança e dados de acesso.</p>
            </div>

            <partial name="_ManageNav" />

            <div class="mt-3">
                @RenderBody()
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}