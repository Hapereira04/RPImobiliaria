@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configurar Aplicação Autenticadora";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="card shadow-sm border-0 border-top border-5 border-primary bg-white text-dark">
    <div class="card-body p-4 p-md-5">

        <h4 class="fw-bold text-dark mb-2">
            <i class="bi bi-qr-code-scan text-primary me-2"></i> @ViewData["Title"]
        </h4>
        <p class="text-secondary small mb-4">Siga os 3 passos abaixo para associar a sua conta a uma aplicação de segurança no seu telemóvel.</p>

        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="row g-4 mt-2">
            <div class="col-md-12">

                <ol class="list-group list-group-numbered shadow-sm">
                    <li class="list-group-item d-flex justify-content-between align-items-start p-4 bg-light border-secondary-subtle">
                        <div class="ms-3 me-auto text-dark">
                            <div class="fw-bold fs-5 mb-2 text-primary">Descarregar a Aplicação</div>
                            <p class="mb-0 text-secondary">Descarregue uma aplicação de autenticação de dois fatores no seu telemóvel:</p>
                            <ul class="mt-2 text-secondary">
                                <li><strong>Microsoft Authenticator:</strong> para <a href="https://go.microsoft.com/fwlink/?Linkid=825072" target="_blank" class="fw-bold text-decoration-none">Android</a> ou <a href="https://go.microsoft.com/fwlink/?Linkid=825073" target="_blank" class="fw-bold text-decoration-none">iOS</a></li>
                                <li><strong>Google Authenticator:</strong> para <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en" target="_blank" class="fw-bold text-decoration-none">Android</a> ou <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" target="_blank" class="fw-bold text-decoration-none">iOS</a></li>
                            </ul>
                        </div>
                    </li>

                    <li class="list-group-item d-flex justify-content-between align-items-start p-4 bg-white border-secondary-subtle">
                        <div class="ms-3 me-auto text-dark w-100">
                            <div class="fw-bold fs-5 mb-2 text-primary">Associar a Conta</div>
                            <p class="mb-3 text-secondary">Na aplicação do seu telemóvel, adicione uma nova conta e insira a seguinte chave manual (os espaços e as letras maiúsculas/minúsculas não importam):</p>

                            <div class="bg-light p-3 rounded border border-primary-subtle text-center mb-2 shadow-sm">
                                <h4 class="fw-mono text-primary mb-0 user-select-all" style="letter-spacing: 2px;">@Model.SharedKey</h4>
                            </div>

                            <div id="qrCode" class="text-center mt-3"></div>
                            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
                        </div>
                    </li>

                    <li class="list-group-item d-flex justify-content-between align-items-start p-4 bg-light border-secondary-subtle border-bottom-0">
                        <div class="ms-3 me-auto text-dark w-100">
                            <div class="fw-bold fs-5 mb-2 text-primary">Confirmar o Código</div>
                            <p class="text-secondary">Após associar a conta, a aplicação irá gerar um código de 6 dígitos que muda a cada 30 segundos. Insira o código atual abaixo para confirmar e ativar a proteção.</p>

                            <form id="send-code" method="post" class="mt-4">
                                <div class="row">
                                    <div class="col-md-8 col-lg-6">
                                        <div class="form-floating mb-3">
                                            <input asp-for="Input.Code" class="form-control border-primary shadow-sm bg-white text-dark fw-bold fs-5 text-center" autocomplete="off" placeholder="123456" maxlength="7" />
                                            <label asp-for="Input.Code" class="text-dark fw-bold">Código de 6 dígitos</label>
                                            <span asp-validation-for="Input.Code" class="text-danger small fw-bold"></span>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm">
                                            <i class="bi bi-shield-check me-1"></i> Validar e Ativar 2FA
                                        </button>
                                        <div asp-validation-summary="ModelOnly" class="text-danger small mt-2 fw-bold" role="alert"></div>
                                    </div>
                                </div>
                            </form>

                        </div>
                    </li>
                </ol>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}