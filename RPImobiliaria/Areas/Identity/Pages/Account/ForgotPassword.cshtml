@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Palavra-passe";
}

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card border-0 border-top border-5 border-primary shadow-lg bg-white">
            <div class="card-body p-4 p-md-5 bg-white">

                <div class="text-center mb-4">
                    <i class="bi bi-key-fill text-primary display-3 mb-3"></i>
                    <h2 class="fw-bold text-dark">Esqueceu-se da senha?</h2>
                    <p class="text-dark fw-medium small">
                        Não se preocupe! Insira o seu e-mail e enviar-lhe-emos as instruções para redefinir a sua palavra-passe.
                    </p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.Email" class="form-control bg-white text-dark border-secondary-subtle fw-medium" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                        <label asp-for="Input.Email" class="form-label text-dark fw-bold">Endereço de E-mail</label>
                        <span asp-validation-for="Input.Email" class="text-danger small fw-bold"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm mb-3">
                        <i class="bi bi-envelope-paper-fill me-2"></i> Enviar link de recuperação
                    </button>

                    <div class="text-center mt-3">
                        <a asp-page="./Login" class="text-decoration-none fw-bold text-primary">
                            <i class="bi bi-arrow-left me-1"></i> Voltar ao Login
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}