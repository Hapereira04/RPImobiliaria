@page
@model LoginModel

@{
    ViewData["Title"] = "Entrar";
}

<style>
    /* ====================================================
       MODO ESCURO - PÁGINA DE LOGIN
       ==================================================== */
    [data-bs-theme="dark"] .login-card {
        background-color: #1e1f22 !important;
        border-color: #333 !important;
    }

    [data-bs-theme="dark"] .form-control {
        background-color: #2b2d31 !important;
        border-color: #444 !important;
        color: #f2f3f5 !important;
    }

    [data-bs-theme="dark"] .form-control:focus {
        background-color: #1e1f22 !important;
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }

    [data-bs-theme="dark"] .form-floating label {
        color: #adb5bd !important;
    }

    [data-bs-theme="dark"] h2,
    [data-bs-theme="dark"] p,
    [data-bs-theme="dark"] label:not(.form-check-label) {
        color: #f2f3f5 !important;
    }

    [data-bs-theme="dark"] .form-check-input {
        background-color: #2b2d31;
        border-color: #444;
    }
</style>

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-5">
        <div class="card shadow login-card rounded-4 border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">Área Reservada</h2>
                    <p class="text-muted">Acesso exclusivo a Consultores e Administração</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">Palavra-passe</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <label asp-for="Input.RememberMe" class="form-check-label">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                Lembrar-me
                            </label>
                        </div>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small">Recuperar password</a>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary rounded-3 fw-bold">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}