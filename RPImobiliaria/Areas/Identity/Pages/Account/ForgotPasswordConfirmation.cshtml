@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Confirmação de e-mail enviada";
}

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card border-0 border-top border-5 border-success shadow-lg bg-white">
            <div class="card-body p-5 text-center bg-white">

                <!-- Ícone Verde de Sucesso -->
                <i class="bi bi-envelope-check-fill text-success display-1 mb-4"></i>

                <h2 class="fw-bold mb-3 text-dark">E-mail Enviado!</h2>

                <p class="fs-6 fw-medium mb-4 text-dark">
                    Por favor, verifique a sua caixa de entrada. Enviámos-lhe uma mensagem com as instruções seguras para redefinir a sua palavra-passe.
                </p>

                <div class="alert alert-warning text-dark border-warning-subtle small fw-bold text-start shadow-sm mb-4" role="alert">
                    <i class="bi bi-info-circle-fill text-warning me-2"></i> Não encontra o e-mail? Verifique também a sua pasta de Spam ou Correio Não Solicitado.
                </div>

                <div class="d-grid gap-2">
                    <a href="~/" class="btn btn-success btn-lg fw-bold px-4 shadow-sm">
                        <i class="bi bi-house-door-fill me-2"></i> Voltar à Página Principal
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>